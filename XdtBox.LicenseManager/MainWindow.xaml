<Window x:Class="XdtBox.LicenseManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XDTBox Lizenzmanager"
        Icon="Assets/App/XDTBox.ico"
        Height="900"
        Width="1500"
        MinHeight="780"
        MinWidth="1280"
        Background="{DynamicResource XdtBoxWindowBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/XdtBoxTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="10" Style="{StaticResource XdtBoxRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource XdtBoxBrandHeaderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="Assets/Branding/XDTBox_Logo_Schriftzug.png"
                       Style="{StaticResource XdtBoxLogoImageStyle}"
                       MaxWidth="340"/>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <TextBlock Text="XDTBox Lizenzmanager"
                               Foreground="{StaticResource XdtBoxDarkTextBrush}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="Lizenzanfragen einlesen, signieren und Kundenlizenzen verwalten"
                               Foreground="{StaticResource XdtBoxMutedTextBrush}"
                               FontSize="12"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>
        <TabControl x:Name="LicenseManagerTabs" Grid.Row="1">
            <TabItem Header="Lizenz erstellen">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <GroupBox Header="Lizenzanfrage" Grid.Row="0" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="0" Content="Lizenzanfrage öffnen" Width="160" Click="OpenRequest_Click"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" x:Name="RequestFileTextBox" Margin="8,0,0,6" IsReadOnly="True"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="InstallationId:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="InstallationIdTextBox" Margin="0,0,16,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Request-Datum:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="RequestDateTextBlock" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="App-Version:" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RequestAppVersionTextBlock" Margin="0,0,16,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Aktive Geräte:" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" x:Name="RequestedActiveConnectionsTextBlock"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Kundendaten" Grid.Row="1" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Praxis/Firma:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" x:Name="CustomerNameTextBox" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Straße:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="StreetTextBox" Margin="0,0,16,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="PLZ / Ort:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <Grid Grid.Row="1" Grid.Column="3" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="PostalCodeTextBox"/>
                                    <TextBox Grid.Column="2" x:Name="CityTextBox"/>
                                </Grid>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Telefon:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="PhoneTextBox" Margin="0,0,16,6"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="E-Mail:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <TextBox Grid.Row="2" Grid.Column="3" x:Name="EmailTextBox" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Ansprechpartner:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="ContactPersonTextBox" Margin="0,0,16,6"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Rechnungs-E-Mail:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <TextBox Grid.Row="3" Grid.Column="3" x:Name="InvoiceEmailTextBox" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="IBAN:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="CustomerIbanTextBox" Margin="0,0,16,6"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="BIC:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <TextBox Grid.Row="4" Grid.Column="3" x:Name="CustomerBicTextBox" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Kontoinhaber:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" x:Name="CustomerAccountHolderTextBox" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Zahlungsart:" FontWeight="Bold" Margin="0,0,8,0"/>
                                <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                                    <CheckBox x:Name="SepaConsentCheckBox" Content="SEPA-Lastschrift" Margin="0,0,22,0" Checked="PaymentMethodCheckBox_Checked" Unchecked="PaymentMethodCheckBox_Unchecked"/>
                                    <CheckBox x:Name="AlwaysInvoiceCheckBox" Content="Banküberweisung" Checked="PaymentMethodCheckBox_Checked" Unchecked="PaymentMethodCheckBox_Unchecked"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Angeforderte Geräteanbindungen" Grid.Row="2" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="180"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" x:Name="RequestDevicesHintTextBlock" Margin="0,0,0,6" Foreground="#666666"
                                           Text="Es werden nur aktive lizenzpflichtige Geräteanbindungen angezeigt."/>
                                <DataGrid Grid.Row="1"
                                          x:Name="RequestDevicesGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Schnittstellenprofil" Binding="{Binding DisplayName}" Width="2*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Geräteprofil" Binding="{Binding DeviceDisplayName}" Width="2*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Standort" Binding="{Binding Location, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="170"/>
                                        <DataGridTextColumn Header="Anbindung" Binding="{Binding ConnectionKind}" Width="120" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Lizenzparameter" Grid.Row="3" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Lizenznehmer:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="LicenseeTextBox" Margin="0,0,16,6"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Kundennummer:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <TextBox Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" x:Name="CustomerNumberTextBox" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Max. Geräteanbindungen:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="MaxActiveConnectionsTextBox" Margin="0,0,16,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Lizenztyp:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <ComboBox Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" x:Name="LicenseTypeComboBox" Margin="0,0,0,6">
                                    <ComboBoxItem Content="Production" IsSelected="True"/>
                                    <ComboBoxItem Content="Support"/>
                                </ComboBox>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Gültig ab:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <DatePicker Grid.Row="2" Grid.Column="1" x:Name="ValidFromDatePicker" Margin="0,0,16,6"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Gültig bis:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <StackPanel Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="unbefristet" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <DatePicker x:Name="ValidUntilDatePicker" Visibility="Collapsed"/>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Karenzzeit Tage:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="GraceDaysTextBox" Margin="0,0,16,6"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="KeyId:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <TextBox Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2" x:Name="KeyIdTextBox" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Private-Key-Pfad:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" x:Name="PrivateKeyPathTextBox" Margin="0,0,8,6"/>
                                <Button Grid.Row="4" Grid.Column="4" Content="Auswählen" Click="BrowsePrivateKey_Click" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Ausgabedatei:" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" x:Name="OutputFileTextBox" Margin="0,0,8,0"/>
                                <Button Grid.Row="5" Grid.Column="4" Content="Vorschlag" Click="SuggestOutputFile_Click"/>
                            </Grid>
                        </GroupBox>

                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0" x:Name="NotesTextBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,8" ToolTip="Notiz"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <Button Content="Lizenz erzeugen" Width="150" Margin="0,0,8,0" Click="CreateLicense_Click"/>
                                <Button Content="Ausgabeordner öffnen" Width="170" Margin="0,0,8,0" Click="OpenOutputFolder_Click"/>
                                <Button Content="Eingaben zurücksetzen" Width="170" Margin="0,0,8,0" Click="ResetInputs_Click"/>
                                <TextBlock x:Name="CreateLicenseStatusText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Kunden">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Preis pro Geräteanbindung netto:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="CustomerPricePerDeviceTextBox" Width="90" Margin="0,0,8,0"/>
                        <TextBlock Text="EUR" VerticalAlignment="Center" Margin="0,0,18,0"/>
                        <TextBlock Text="Suche:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="CustomerSearchTextBox" Width="320" Margin="0,0,8,0" TextChanged="CustomerSearchTextBox_TextChanged"/>
                        <Button Content="Kunde öffnen" Width="130" Margin="0,0,8,0" Click="OpenCustomer_Click"/>
                        <Button x:Name="MergeCustomersButton" Content="Zusammenführen" Width="130" Margin="0,0,8,0" IsEnabled="False" Click="MergeCustomers_Click"/>
                        <Button Content="Kundenliste als PDF exportieren" Width="230" Margin="0,0,8,0" Click="ExportCustomersPdf_Click"/>
                        <Button Content="Preis speichern" Width="130" Click="SaveCustomerPrice_Click"/>
                    </WrapPanel>

                    <DataGrid Grid.Row="1"
                              x:Name="CustomersGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              MouseDoubleClick="CustomersGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding IsMarked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
                            <DataGridTextColumn Header="Kundennummer" Binding="{Binding CustomerNumber}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Praxis/Firma" Binding="{Binding CustomerName}" Width="260" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Ansprechpartner" Binding="{Binding ContactPerson}" Width="160" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Rechnungs-E-Mail" Binding="{Binding InvoiceEmail}" Width="220" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Zahlungsart" Binding="{Binding PaymentMethodDisplay}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="IBAN" Binding="{Binding Iban}" Width="220" IsReadOnly="True"/>
                            <DataGridTextColumn Header="BIC" Binding="{Binding Bic}" Width="130" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Kontoinhaber" Binding="{Binding AccountHolder}" Width="190" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Installationen" Binding="{Binding ActiveInstallationCount}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Geräte" Binding="{Binding ActiveLicensedDeviceCount}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Einzelpreis netto" Binding="{Binding PricePerDeviceNetDisplay}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Kosten netto" Binding="{Binding TotalNetDisplay}" Width="130" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Letzte Lizenz" Binding="{Binding LastLicenseIssuedDisplay}" Width="130" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Gültig bis" Binding="{Binding LicenseValidUntilDisplay}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Installationen / IDs" Binding="{Binding InstallationIdsDisplay}" Width="260" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" x:Name="CustomersStatusText" Margin="0,8,0,0"/>
                    <Border Grid.Row="3" BorderBrush="#BFD9E8" BorderThickness="1" Background="#EAF7FC" Padding="10" Margin="0,8,0,0">
                        <TextBlock x:Name="CustomerMonthlyTotalTextBlock" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Ausgestellte Lizenzen">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Suche:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="HistorySearchTextBox" Width="320" Margin="0,0,8,0" TextChanged="HistorySearchTextBox_TextChanged"/>
                        <Button Content="Historie neu laden" Width="150" Margin="0,0,8,0" Click="ReloadHistory_Click"/>
                        <Button Content="Historie exportieren" Width="150" Margin="0,0,8,0" Click="ExportHistory_Click"/>
                        <Button x:Name="DeleteHistoryEntryButton" Content="Eintrag entfernen" Width="150" IsEnabled="False" Click="DeleteHistoryEntry_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              x:Name="HistoryGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionChanged="HistoryGrid_SelectionChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kundennummer" Binding="{Binding CustomerNumber}" Width="150"/>
                            <DataGridTextColumn Header="Kunde" Binding="{Binding CustomerName}" Width="3*"/>
                            <DataGridTextColumn Header="Ort" Binding="{Binding City}" Width="2*"/>
                            <DataGridTextColumn Header="Geräte" Binding="{Binding MaxActiveDeviceConnections}" Width="90"/>
                            <DataGridTextColumn Header="Ausstellungsdatum" Binding="{Binding IssuedAtDisplay}" Width="170"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GroupBox Grid.Row="2" Header="Details zur ausgewählten Lizenz" Margin="0,0,0,8">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Kunde:" FontWeight="Bold" Margin="0,0,8,5"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="HistoryDetailCustomerText" Margin="0,0,18,5"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Kundennummer:" FontWeight="Bold" Margin="0,0,8,5"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" x:Name="HistoryDetailCustomerNumberText" Margin="0,0,18,5"/>
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Zahlungsart:" FontWeight="Bold" Margin="0,0,8,5"/>
                                <TextBlock Grid.Row="0" Grid.Column="5" x:Name="HistoryDetailPaymentText" Margin="0,0,0,5"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Adresse:" FontWeight="Bold" Margin="0,0,8,5"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="HistoryDetailAddressText" Margin="0,0,18,5"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Ort:" FontWeight="Bold" Margin="0,0,8,5"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="HistoryDetailCityText" Margin="0,0,18,5"/>
                                <TextBlock Grid.Row="1" Grid.Column="4" Text="Ansprechpartner:" FontWeight="Bold" Margin="0,0,8,5"/>
                                <TextBlock Grid.Row="1" Grid.Column="5" x:Name="HistoryDetailContactText" Margin="0,0,0,5"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Telefon:" FontWeight="Bold" Margin="0,0,8,5"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="HistoryDetailPhoneText" Margin="0,0,18,5"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="E-Mail:" FontWeight="Bold" Margin="0,0,8,5"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" x:Name="HistoryDetailEmailText" Margin="0,0,18,5"/>
                                <TextBlock Grid.Row="2" Grid.Column="4" Text="Rechnungs-E-Mail:" FontWeight="Bold" Margin="0,0,8,5"/>
                                <TextBlock Grid.Row="2" Grid.Column="5" x:Name="HistoryDetailInvoiceEmailText" Margin="0,0,0,5"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="InstallationId:" FontWeight="Bold" Margin="0,0,8,5"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="HistoryDetailInstallationText" Margin="0,0,18,5"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Computername:" FontWeight="Bold" Margin="0,0,8,5"/>
                                <TextBlock Grid.Row="3" Grid.Column="3" x:Name="HistoryDetailMachineText" Margin="0,0,18,5"/>
                                <TextBlock Grid.Row="3" Grid.Column="4" Text="Geräteanzahl:" FontWeight="Bold" Margin="0,0,8,5"/>
                                <TextBlock Grid.Row="3" Grid.Column="5" x:Name="HistoryDetailDeviceCountText" Margin="0,0,0,5"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Lizenz:" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="HistoryDetailLicenseText" Margin="0,0,18,0"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="Ausgestellt am:" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="4" Grid.Column="3" x:Name="HistoryDetailIssuedText" Margin="0,0,18,0"/>
                                <TextBlock Grid.Row="4" Grid.Column="4" Text="Gültig bis:" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="4" Grid.Column="5" x:Name="HistoryDetailValidUntilText"/>
                            </Grid>

                            <DataGrid Grid.Row="1"
                                      x:Name="HistoryDevicesGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Anbindung" Binding="{Binding DisplayName}" Width="3*"/>
                                    <DataGridTextColumn Header="Gerät" Binding="{Binding DeviceDisplayName}" Width="2*"/>
                                    <DataGridTextColumn Header="Standort" Binding="{Binding Location}" Width="170"/>
                                    <DataGridTextColumn Header="Quelle / Verbindung" Binding="{Binding ConnectionKind}" Width="180"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Grid.Row="2">
                                <Button Content="Lizenzdatei öffnen" Width="150" Margin="0,0,8,0" Click="OpenSelectedLicenseFile_Click"/>
                                <Button Content="Ordner öffnen" Width="130" Margin="0,0,8,0" Click="OpenSelectedLicenseFolder_Click"/>
                                <Button Content="Neue Lizenz für diesen Kunden erstellen" Width="260" Margin="0,0,8,0" Click="CreateNewForSelectedCustomer_Click"/>
                                <Button Content="Kundendaten übernehmen" Width="180" Margin="0,0,8,0" Click="UseSelectedCustomerData_Click"/>
                            </WrapPanel>
                        </Grid>
                    </GroupBox>

                    <TextBlock Grid.Row="3" x:Name="HistoryStatusText" Margin="0,0,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="Sicherung">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="#E0A126" BorderThickness="1" Background="#FFF4D6" Padding="8" Margin="0,0,0,8">
                        <TextBlock Text="Sicherungen enthalten Kunden, Bank-/SEPA-Daten, Preis, Historie und Einstellungen. Private Keys und Signaturschlüssel werden nicht gesichert." TextWrapping="Wrap"/>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Sicherung erstellen" Width="170" Margin="0,0,8,0" Click="CreateBackup_Click"/>
                        <Button Content="Sicherung wiederherstellen" Width="200" Click="RestoreBackup_Click"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" x:Name="BackupStatusText" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <TabItem Header="Einstellungen">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Standard-Ausgabeordner:" FontWeight="Bold" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="SettingsOutputFolderTextBox" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Standard-Request-Ordner:" FontWeight="Bold" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="SettingsRequestFolderTextBox" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Standard-Key-Ordner:" FontWeight="Bold" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="SettingsKeyFolderTextBox" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Private-Key-Pfad:" FontWeight="Bold" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="SettingsPrivateKeyPathTextBox" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="KeyId:" FontWeight="Bold" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="SettingsKeyIdTextBox" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Issuer / Karenzzeit:" FontWeight="Bold" Margin="0,0,8,8"/>
                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="SettingsIssuerTextBox" Width="260" Margin="0,0,8,0"/>
                        <TextBox x:Name="SettingsGraceDaysTextBox" Width="80"/>
                        <TextBlock Text=" Tage" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Preis netto je Gerät:" FontWeight="Bold" Margin="0,0,8,8"/>
                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="SettingsPricePerDeviceTextBox" Width="100" Margin="0,0,8,0"/>
                        <TextBlock Text="EUR" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2">
                        <Border BorderBrush="#E0A126" BorderThickness="1" Background="#FFF4D6" Padding="8" Margin="0,0,0,8">
                            <TextBlock Text="Der private Schlüssel bleibt ausschließlich beim Hersteller. Die Datei darf nicht weitergegeben und nicht ins Repository übernommen werden." TextWrapping="Wrap"/>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Einstellungen speichern" Width="190" Margin="0,0,8,0" Click="SaveSettings_Click"/>
                            <Button Content="Arbeitsordner anlegen" Width="170" Margin="0,0,8,0" Click="CreateWorkingFolders_Click"/>
                            <TextBlock x:Name="SettingsStatusText" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
