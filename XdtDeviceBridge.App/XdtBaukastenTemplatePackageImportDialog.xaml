<Window x:Class="XdtDeviceBridge.App.XdtBaukastenTemplatePackageImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Template Paket importieren"
        Height="720"
        Width="1120"
        MinHeight="620"
        MinWidth="980"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/App/XDTBox.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Template Paket importieren"
                       FontSize="18"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="SummaryTextBlock"
                       Margin="0,6,0,10"
                       Foreground="DimGray"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Prüfung und Hinweise" Margin="0,0,0,10">
            <TextBox x:Name="MessagesTextBox"
                     AcceptsReturn="True"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Importauswahl" Margin="0,0,0,10">
            <DataGrid x:Name="PreviewGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CellEditEnding="PreviewGrid_CellEditEnding">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Art" Binding="{Binding ProfileKind}" Width="130" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Paketprofil" Binding="{Binding ImportedProfileName}" Width="220" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Aktion" Width="190">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PlannedAction}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding AvailableActions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Action"
                                          SelectedValue="{Binding SelectedAction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsActionSelectionEnabled}"
                                          SelectionChanged="ActionComboBox_SelectionChanged"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Zielname" Binding="{Binding TargetProfileName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="220"/>
                    <DataGridTextColumn Header="Konflikt" Binding="{Binding Conflict}" Width="170" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Hinweis" Binding="{Binding Message}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Schnittstellenprofil-Abhängigkeiten" Margin="0,0,0,10">
            <Grid>
                <TextBlock x:Name="DependencyEmptyTextBlock"
                           Foreground="DimGray"
                           TextWrapping="Wrap"/>
                <DataGrid x:Name="DependencyGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Schnittstellenprofil" Binding="{Binding InterfaceProfileName}" Width="190"/>
                        <DataGridTextColumn Header="Abhängigkeit" Binding="{Binding DependencyKind}" Width="140"/>
                        <DataGridTextColumn Header="Original" Binding="{Binding OriginalProfileName}" Width="190"/>
                        <DataGridTextColumn Header="Ziel" Binding="{Binding TargetProfileName}" Width="190"/>
                        <DataGridTextColumn Header="Auflösung" Binding="{Binding Resolution}" Width="140"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                        <DataGridTextColumn Header="Hinweis" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <DockPanel Grid.Row="4">
            <TextBox x:Name="ExecutionResultTextBox"
                     DockPanel.Dock="Left"
                     MinWidth="520"
                     Height="72"
                     AcceptsReturn="True"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="Noch keine Importübernahme ausgeführt."/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button x:Name="RefreshPreviewButton"
                        Content="Vorschau aktualisieren"
                        Width="150"
                        Margin="10,0,8,0"
                        Click="RefreshPreview_Click"/>
                <Button x:Name="ImportButton"
                        Content="Import übernehmen"
                        Width="150"
                        Margin="0,0,8,0"
                        Click="Import_Click"/>
                <Button Content="Schließen"
                        Width="110"
                        IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
