<Window x:Class="XdtDeviceBridge.App.TabProtectionPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tab-Schutz"
        Icon="Assets/App/XDTBox.ico"
        Height="230"
        Width="440"
        MinHeight="230"
        MinWidth="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource XdtBoxWindowBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/XdtBoxTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Geschützter Bereich"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource XdtBoxPrimaryBrush}"/>
        <TextBlock Grid.Row="1"
                   x:Name="PromptTextBlock"
                   TextWrapping="Wrap"
                   Margin="0,6,0,12"
                   Foreground="{StaticResource XdtBoxMutedTextBrush}"/>
        <PasswordBox Grid.Row="2"
                     x:Name="PasswordBox"
                     Height="28"
                     PasswordChar="●"
                     KeyDown="PasswordBox_KeyDown"/>
        <TextBlock Grid.Row="3"
                   x:Name="ErrorTextBlock"
                   Foreground="#A32121"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"/>

        <DockPanel Grid.Row="4" Margin="0,16,0,0" LastChildFill="False">
            <Button Content="Abbrechen"
                    Width="120"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    DockPanel.Dock="Right"/>
            <Button Content="Entsperren"
                    Width="120"
                    IsDefault="True"
                    Click="Unlock_Click"
                    DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
