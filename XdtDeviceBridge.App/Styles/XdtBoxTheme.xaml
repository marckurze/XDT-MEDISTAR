<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="XdtBoxPrimaryColor">#00549A</Color>
    <Color x:Key="XdtBoxPrimaryDarkColor">#003D73</Color>
    <Color x:Key="XdtBoxPrimarySoftColor">#EAF5FF</Color>
    <Color x:Key="XdtBoxAccentColor">#00B7C7</Color>
    <Color x:Key="XdtBoxAccentSoftColor">#E8FBFD</Color>
    <Color x:Key="XdtBoxWindowBackgroundColor">#F3F8FB</Color>
    <Color x:Key="XdtBoxPanelBackgroundColor">#FFFFFF</Color>
    <Color x:Key="XdtBoxPanelMutedBackgroundColor">#F8FBFD</Color>
    <Color x:Key="XdtBoxBorderColor">#CFE0EA</Color>
    <Color x:Key="XdtBoxBorderStrongColor">#AFC8D8</Color>
    <Color x:Key="XdtBoxTextColor">#102333</Color>
    <Color x:Key="XdtBoxMutedTextColor">#637182</Color>
    <Color x:Key="XdtBoxHoverColor">#EAF6FC</Color>
    <Color x:Key="XdtBoxPressedColor">#D7ECF8</Color>
    <Color x:Key="XdtBoxSelectionColor">#D9EFFB</Color>
    <Color x:Key="XdtBoxFocusColor">#1D89C7</Color>
    <Color x:Key="XdtBoxSuccessColor">#11B981</Color>
    <Color x:Key="XdtBoxSuccessDarkColor">#07845C</Color>
    <Color x:Key="XdtBoxDangerColor">#EF3E52</Color>
    <Color x:Key="XdtBoxDangerDarkColor">#B92235</Color>
    <Color x:Key="XdtBoxWarningColor">#FFA726</Color>
    <Color x:Key="XdtBoxWarningSoftColor">#FFF7E2</Color>
    <Color x:Key="XdtBoxInfoSoftColor">#EAF7FF</Color>

    <SolidColorBrush x:Key="XdtBoxPrimaryBrush" Color="{StaticResource XdtBoxPrimaryColor}" />
    <SolidColorBrush x:Key="XdtBoxPrimaryDarkBrush" Color="{StaticResource XdtBoxPrimaryDarkColor}" />
    <SolidColorBrush x:Key="XdtBoxPrimarySoftBrush" Color="{StaticResource XdtBoxPrimarySoftColor}" />
    <SolidColorBrush x:Key="XdtBoxAccentBrush" Color="{StaticResource XdtBoxAccentColor}" />
    <SolidColorBrush x:Key="XdtBoxAccentSoftBrush" Color="{StaticResource XdtBoxAccentSoftColor}" />
    <SolidColorBrush x:Key="XdtBoxWindowBackgroundBrush" Color="{StaticResource XdtBoxWindowBackgroundColor}" />
    <SolidColorBrush x:Key="XdtBoxPanelBackgroundBrush" Color="{StaticResource XdtBoxPanelBackgroundColor}" />
    <SolidColorBrush x:Key="XdtBoxPanelMutedBackgroundBrush" Color="{StaticResource XdtBoxPanelMutedBackgroundColor}" />
    <SolidColorBrush x:Key="XdtBoxBorderBrush" Color="{StaticResource XdtBoxBorderColor}" />
    <SolidColorBrush x:Key="XdtBoxBorderStrongBrush" Color="{StaticResource XdtBoxBorderStrongColor}" />
    <SolidColorBrush x:Key="XdtBoxTextBrush" Color="{StaticResource XdtBoxTextColor}" />
    <SolidColorBrush x:Key="XdtBoxDarkTextBrush" Color="{StaticResource XdtBoxTextColor}" />
    <SolidColorBrush x:Key="XdtBoxMutedTextBrush" Color="{StaticResource XdtBoxMutedTextColor}" />
    <SolidColorBrush x:Key="XdtBoxHoverBrush" Color="{StaticResource XdtBoxHoverColor}" />
    <SolidColorBrush x:Key="XdtBoxPressedBrush" Color="{StaticResource XdtBoxPressedColor}" />
    <SolidColorBrush x:Key="XdtBoxSelectionBrush" Color="{StaticResource XdtBoxSelectionColor}" />
    <SolidColorBrush x:Key="XdtBoxFocusBrush" Color="{StaticResource XdtBoxFocusColor}" />
    <SolidColorBrush x:Key="XdtBoxSuccessBrush" Color="{StaticResource XdtBoxSuccessColor}" />
    <SolidColorBrush x:Key="XdtBoxSuccessDarkBrush" Color="{StaticResource XdtBoxSuccessDarkColor}" />
    <SolidColorBrush x:Key="XdtBoxDangerBrush" Color="{StaticResource XdtBoxDangerColor}" />
    <SolidColorBrush x:Key="XdtBoxDangerDarkBrush" Color="{StaticResource XdtBoxDangerDarkColor}" />
    <SolidColorBrush x:Key="XdtBoxWarningBrush" Color="{StaticResource XdtBoxWarningColor}" />
    <SolidColorBrush x:Key="XdtBoxWarningSoftBrush" Color="{StaticResource XdtBoxWarningSoftColor}" />
    <SolidColorBrush x:Key="XdtBoxInfoSoftBrush" Color="{StaticResource XdtBoxInfoSoftColor}" />
    <SolidColorBrush x:Key="XdtBoxWhiteboardBrush" Color="#FCFEFF" />

    <LinearGradientBrush x:Key="XdtBoxHeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F4FBFC" Offset="0.45" />
        <GradientStop Color="#E8F8F9" Offset="1" />
    </LinearGradientBrush>

    <CornerRadius x:Key="XdtBoxCornerSmall">4</CornerRadius>
    <CornerRadius x:Key="XdtBoxCornerMedium">8</CornerRadius>
    <CornerRadius x:Key="XdtBoxCornerLarge">12</CornerRadius>
    <Thickness x:Key="XdtBoxCardPadding">16</Thickness>
    <Thickness x:Key="XdtBoxCompactPadding">8</Thickness>

    <DropShadowEffect x:Key="XdtBoxCardShadowEffect"
                      BlurRadius="10"
                      Direction="270"
                      Opacity="0.10"
                      ShadowDepth="1"
                      Color="#536D7A" />
    <DropShadowEffect x:Key="XdtBoxSoftShadowEffect"
                      BlurRadius="14"
                      Direction="270"
                      Opacity="0.16"
                      ShadowDepth="2"
                      Color="#4A6572" />

    <Style x:Key="XdtBoxRootGridStyle" TargetType="{x:Type Grid}">
        <Setter Property="Background" Value="{DynamicResource XdtBoxWindowBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource XdtBoxTextBrush}" />
        <Setter Property="TextElement.FontFamily" Value="Segoe UI" />
        <Setter Property="TextElement.FontSize" Value="13" />
    </Style>

    <Style x:Key="XdtBoxBrandHeaderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource XdtBoxHeaderGradientBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource XdtBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource XdtBoxCornerLarge}" />
        <Setter Property="Padding" Value="20,14" />
        <Setter Property="Effect" Value="{StaticResource XdtBoxCardShadowEffect}" />
    </Style>

    <Style x:Key="XdtBoxLogoImageStyle" TargetType="{x:Type Image}">
        <Setter Property="Width" Value="250" />
        <Setter Property="Height" Value="90" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    </Style>

    <Style x:Key="XdtBoxCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource XdtBoxPanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource XdtBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource XdtBoxCornerMedium}" />
        <Setter Property="Padding" Value="{StaticResource XdtBoxCardPadding}" />
    </Style>

    <Style x:Key="XdtBoxSectionCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource XdtBoxCardStyle}">
        <Setter Property="Margin" Value="0,6,0,10" />
        <Setter Property="Effect" Value="{StaticResource XdtBoxCardShadowEffect}" />
    </Style>

    <Style x:Key="XdtBoxHeaderCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource XdtBoxCardStyle}">
        <Setter Property="Background" Value="{DynamicResource XdtBoxPanelMutedBackgroundBrush}" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="XdtBoxInfoCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource XdtBoxCardStyle}">
        <Setter Property="Background" Value="{DynamicResource XdtBoxInfoSoftBrush}" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="XdtBoxWarningCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource XdtBoxCardStyle}">
        <Setter Property="Background" Value="{DynamicResource XdtBoxWarningSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource XdtBoxWarningBrush}" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="XdtBoxWhiteboardSurfaceStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource XdtBoxSectionCardStyle}">
        <Setter Property="Background" Value="{DynamicResource XdtBoxPanelBackgroundBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource XdtBoxTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{DynamicResource XdtBoxWindowBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource XdtBoxTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="TabChrome"
                            Background="{DynamicResource XdtBoxPanelMutedBackgroundBrush}"
                            BorderBrush="{DynamicResource XdtBoxBorderBrush}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="8,8,0,0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ContentSource="Header"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource XdtBoxHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource XdtBoxPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource XdtBoxPanelBackgroundBrush}" />
                            <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource XdtBoxBorderStrongBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource XdtBoxPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource XdtBoxMutedTextBrush}" />
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type GroupBox}">
        <Setter Property="Foreground" Value="{DynamicResource XdtBoxTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="Margin" Value="0,6,0,10" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Margin="12,0,0,-1"
                                Padding="8,0"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource XdtBoxWindowBackgroundBrush}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Border Grid.Row="1"
                                Background="{DynamicResource XdtBoxPanelBackgroundBrush}"
                                BorderBrush="{DynamicResource XdtBoxBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource XdtBoxCornerMedium}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Expander}">
        <Setter Property="Foreground" Value="{DynamicResource XdtBoxTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="Margin" Value="0,6,0,10" />
    </Style>

    <Style x:Key="XdtBoxStandardButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource XdtBoxPanelMutedBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource XdtBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource XdtBoxTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource XdtBoxCornerSmall}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource XdtBoxHoverBrush}" />
                            <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource XdtBoxFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource XdtBoxPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource XdtBoxFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Opacity" Value="0.55" />
                            <Setter TargetName="ButtonChrome" Property="Background" Value="#F3F5F7" />
                            <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#BFC7CE" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource XdtBoxStandardButtonStyle}" />

    <Style x:Key="XdtBoxPrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource XdtBoxStandardButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource XdtBoxPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource XdtBoxPrimaryDarkBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="XdtBoxSecondaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource XdtBoxStandardButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource XdtBoxPanelMutedBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource XdtBoxBorderBrush}" />
    </Style>

    <Style x:Key="XdtBoxSuccessButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource XdtBoxStandardButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource XdtBoxSuccessBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource XdtBoxSuccessDarkBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="XdtBoxDangerButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource XdtBoxStandardButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource XdtBoxDangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource XdtBoxDangerDarkBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="XdtBoxIconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource XdtBoxStandardButtonStyle}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource XdtBoxPrimaryBrush}" />
    </Style>

    <Style x:Key="XdtBoxTabUtilityButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource XdtBoxIconButtonStyle}">
        <Setter Property="Margin" Value="4,0,0,0" />
    </Style>

    <Style x:Key="XdtBoxActivationToggleButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource XdtBoxSuccessButtonStyle}">
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="Effect" Value="{StaticResource XdtBoxCardShadowEffect}" />
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource XdtBoxPanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource XdtBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource XdtBoxTextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource XdtBoxSelectionBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="TextBoxChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource XdtBoxCornerSmall}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TextBoxChrome" Property="BorderBrush" Value="{DynamicResource XdtBoxFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="TextBoxChrome" Property="Background" Value="{DynamicResource XdtBoxPanelMutedBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.60" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type PasswordBox}">
        <Setter Property="Background" Value="{DynamicResource XdtBoxPanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource XdtBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource XdtBoxTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type PasswordBox}">
                    <Border x:Name="PasswordBoxChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource XdtBoxCornerSmall}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PasswordBoxChrome" Property="BorderBrush" Value="{DynamicResource XdtBoxFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.60" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="{DynamicResource XdtBoxPanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource XdtBoxBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource XdtBoxTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource XdtBoxTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{DynamicResource XdtBoxTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="{DynamicResource XdtBoxPanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource XdtBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource XdtBoxBorderBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource XdtBoxBorderBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource XdtBoxPanelMutedBackgroundBrush}" />
        <Setter Property="RowBackground" Value="{DynamicResource XdtBoxPanelBackgroundBrush}" />
        <Setter Property="RowHeight" Value="30" />
        <Setter Property="ColumnHeaderHeight" Value="32" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource XdtBoxPanelMutedBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource XdtBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Foreground" Value="{DynamicResource XdtBoxTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <Style TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="{DynamicResource XdtBoxPanelBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource XdtBoxTextBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource XdtBoxHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource XdtBoxSelectionBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource XdtBoxTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="XdtBoxInterfaceActivationToggleStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="78" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <Border x:Name="Track"
                                CornerRadius="19"
                                Background="{DynamicResource XdtBoxDangerBrush}"
                                BorderBrush="{DynamicResource XdtBoxDangerDarkBrush}"
                                BorderThickness="1" />
                        <Ellipse x:Name="Knob"
                                 Width="32"
                                 Height="32"
                                 Margin="3"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Fill="White">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" Opacity="0.30" ShadowDepth="1" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource XdtBoxSuccessBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource XdtBoxSuccessDarkBrush}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="XdtBoxInterfaceActivationSwitchStyle" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource XdtBoxInterfaceActivationToggleStyle}" />

    <Style x:Key="XdtBoxTabProtectionToggleStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="62" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource XdtBoxMutedTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Chrome"
                            Background="{DynamicResource XdtBoxPanelMutedBackgroundBrush}"
                            BorderBrush="{DynamicResource XdtBoxBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource XdtBoxCornerSmall}">
                        <TextBlock x:Name="StateText"
                                   Text="AUS"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource XdtBoxSuccessBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource XdtBoxSuccessDarkBrush}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter TargetName="StateText" Property="Text" Value="AN" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource XdtBoxFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
