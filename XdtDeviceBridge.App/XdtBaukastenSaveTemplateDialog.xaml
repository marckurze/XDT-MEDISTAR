<Window x:Class="XdtDeviceBridge.App.XdtBaukastenSaveTemplateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Baukasten-Konfiguration speichern"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="Assets/App/XDTBox.ico">
    <Grid Margin="16" MinWidth="620">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Templatename:" FontWeight="Bold" Margin="0,2,8,12"/>
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
            <TextBox x:Name="TemplateNameTextBox" MinWidth="420"/>
            <TextBlock Text="Es wird ein neues UserDefined-Exportprofil aus der Baukasten-Arbeitskopie erzeugt."
                       Foreground="DimGray"
                       TextWrapping="Wrap"
                       Margin="0,3,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Beschreibung:" FontWeight="Bold" Margin="0,2,8,12"/>
        <TextBox x:Name="DescriptionTextBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 Height="80"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,12"/>

        <Border Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                BorderBrush="#D8E3EA"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,14">
            <TextBlock x:Name="ConflictHintTextBlock"
                       Foreground="DimGray"
                       TextWrapping="Wrap"
                       Text="BuiltIn-Profile werden nicht überschrieben. Bei Namenskonflikten muss ein anderer Templatename gewählt werden."/>
        </Border>

        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Speichern" Width="110" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
            <Button Content="Abbrechen" Width="110" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
