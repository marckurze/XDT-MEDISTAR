<Window x:Class="XdtDeviceBridge.App.AisOutputInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infrastructure="clr-namespace:XdtDeviceBridge.Infrastructure;assembly=XdtDeviceBridge.Infrastructure"
        Title="AIS Ausgabe Info"
        Width="1040"
        Height="650"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource XdtBoxWindowBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/XdtBoxTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="AisOutputInfoRowStyle" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Setter Property="Background" Value="{StaticResource XdtBoxPanelBackgroundBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCardField}" Value="True">
                        <Setter Property="Background" Value="#EAF7EF"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsOptional}" Value="True">
                        <Setter Property="Background" Value="#FFF6DC"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="AIS Ausgabe Info"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

        <Border Grid.Row="1"
                Style="{StaticResource XdtBoxHeaderCardStyle}"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="155"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="155"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Schnittstellenprofil:" FontWeight="Bold" Margin="0,0,8,6"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InterfaceProfileName}" TextWrapping="Wrap" Margin="0,0,18,6"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Status:" FontWeight="Bold" Margin="0,0,8,6"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding ActiveText}" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="AIS-Profil:" FontWeight="Bold" Margin="0,0,8,6"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AisProfileName}" TextWrapping="Wrap" Margin="0,0,18,6"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Geräteprofil:" FontWeight="Bold" Margin="0,0,8,6"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding DeviceProfileName}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Exportprofil:" FontWeight="Bold" Margin="0,0,8,6"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ExportProfileName}" TextWrapping="Wrap" Margin="0,0,18,6"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Gerät:" FontWeight="Bold" Margin="0,0,8,6"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding DeviceSummary}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Untersuchungsart:" FontWeight="Bold" Margin="0,0,8,0"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DefaultExaminationType}" Margin="0,0,18,0"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="Verbindung:" FontWeight="Bold" Margin="0,0,8,0"/>
                <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding ConnectionKind}" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Fields}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowStyle="{StaticResource AisOutputInfoRowStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Feldkennung" Binding="{Binding FieldCode}" Width="110"/>
                <DataGridTextColumn Header="Ausgabeart/Bedeutung" Binding="{Binding Meaning}" Width="220"/>
                <DataGridTextColumn Header="AIS-Relevanz" Binding="{Binding AisRelevance}" Width="250"/>
                <DataGridTextColumn Header="Karteikarte" Binding="{Binding CardVisibility}" Width="110"/>
                <DataGridTextColumn Header="Hinweis" Binding="{Binding Hint}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3"
                Visibility="{Binding StandardCardLineInfoVisibility}"
                Style="{StaticResource XdtBoxInfoCardStyle}"
                Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Standard Zeilenbenennung in MEDISTAR:"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding StandardCardLineInfos}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type infrastructure:MedistarCardLineInfo}">
                            <Border BorderBrush="#BCD7E5"
                                    BorderThickness="1"
                                    Background="White"
                                    Padding="8,4"
                                    Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding LineCode}"
                                               FontWeight="Bold"
                                               Width="26"/>
                                    <TextBlock Text="{Binding Meaning}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="XDTBox erzeugt diese Zeilenkennungen nicht. Sie dienen Technikern als Hinweis fuer das MEDISTAR-XDT-Setup."
                           TextWrapping="Wrap"
                           Foreground="#52636F"
                           FontSize="12"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <Button Content="Schließen"
                    Style="{StaticResource XdtBoxPrimaryButtonStyle}"
                    Width="120"
                    Margin="16,0,0,0"
                    HorizontalAlignment="Right"
                    Click="Close_Click"
                    DockPanel.Dock="Right"/>
            <Border Style="{StaticResource XdtBoxWarningCardStyle}"
                    DockPanel.Dock="Left">
                <DockPanel>
                    <TextBlock Text="💡"
                               FontSize="18"
                               Margin="0,0,8,0"
                               VerticalAlignment="Top"/>
                    <TextBlock Text="{Binding ExaminationTypeHint}"
                               TextWrapping="Wrap"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#5A3A00"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </DockPanel>
    </Grid>
</Window>
