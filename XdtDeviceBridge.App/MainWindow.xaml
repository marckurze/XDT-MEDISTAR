                                            <TextBlock Text=" ms" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="4" Grid.Column="0" x:Name="InterfaceNidekRtSerialSendModeLabel" Text="NIDEK-RT Sendemodus:" FontWeight="Bold" Margin="0,0,8,8"/>
                                        <ComboBox Grid.Row="4"
                                                  Grid.Column="1"
                                                  Grid.ColumnSpan="2"
                                                  x:Name="InterfaceNidekRtSerialSendModeComboBox"
                                                  SelectedValuePath="Tag"
                                                  SelectedValue="RsThenWriterWithoutSd"
                                                  Width="260"
                                                  HorizontalAlignment="Left"
                                                  Margin="0,0,8,8"
