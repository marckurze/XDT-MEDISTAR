<Window x:Class="XdtDeviceBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:XdtDeviceBridge.Core;assembly=XdtDeviceBridge.Core"
        xmlns:local="clr-namespace:XdtDeviceBridge.App"
        Title="XDTBox"
        Icon="Assets/App/XDTBox.ico"
        Height="900"
        Width="1200"
        MinHeight="800"
        MinWidth="1200"
        Background="{DynamicResource XdtBoxWindowBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/XdtBoxTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:DeviceImageSourceConverter x:Key="DeviceImageSourceConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="12" Style="{StaticResource XdtBoxRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource XdtBoxBrandHeaderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="Assets/Branding/XDTBox_Logo_Schriftzug.png"
                       Style="{StaticResource XdtBoxLogoImageStyle}"
                       MaxWidth="360"/>
                <DockPanel Grid.Column="1"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           LastChildFill="False">
                    <TextBlock Text="Medizinische Geräte sicher verbinden"
                               DockPanel.Dock="Right"
                               Foreground="{StaticResource XdtBoxDarkTextBrush}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"/>
                </DockPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel x:Name="TabUtilityButtonsPanel"
                        Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,4,12,4">
                <Button x:Name="TabBaukastenUndoButton"
                        Content="↶"
                        Style="{StaticResource XdtBoxTabUtilityButtonStyle}"
                        ToolTip="Letzte Baukasten-Änderung rückgängig machen"
                        IsEnabled="False"
                        Click="XdtBaukastenUndo_Click"/>
                <Button x:Name="TabHelpButton"
                        Content="?"
                        Style="{StaticResource XdtBoxTabUtilityButtonStyle}"
                        ToolTip="Hilfe und Info"
                        Click="TabHelpButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Hilfe" Click="OpenHelpCenter_Click"/>
                            <MenuItem Header="Info" Click="OpenAboutDialog_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="AppSettingsButton"
                        Content="⚙"
                        Style="{StaticResource XdtBoxTabUtilityButtonStyle}"
                        ToolTip="App-Einstellungen"
                        Click="OpenAppSettings_Click"/>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="4,0,6,0">
                    <TextBlock x:Name="TabProtectionStatusTextBlock"
                               Text="TAB Schutz nicht aktiviert"
                               VerticalAlignment="Center"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource XdtBoxMutedTextBrush}"
                               Margin="0,0,6,0"/>
                    <ToggleButton x:Name="TabProtectionToggleButton"
                                  Style="{StaticResource XdtBoxTabProtectionToggleStyle}"
                                  ToolTip="Tab-Schutz sperren oder entsperren"
                                  Click="TabProtectionToggleButton_Click"/>
                </StackPanel>
                <Button x:Name="AppExitButton"
                        Content="Beenden"
                        Width="86"
                        Style="{StaticResource XdtBoxTabUtilityButtonStyle}"
                        FontSize="13"
                        ToolTip="XDTBox vollständig beenden"
                        Click="AppExitButton_Click"/>
            </StackPanel>
        <TabControl x:Name="MainTabControl"
                    Grid.Row="1"
                    SelectionChanged="MainTabControl_SelectionChanged">
            <TabItem Header="Verarbeitung">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="8" MinHeight="700">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <GroupBox Header="Aktive Schnittstellenprofile" Grid.Row="0" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.Resources>
                                    <Style x:Key="MonitoringCardBorderStyle" TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#34D399"/>
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#F6FFF9" Offset="0"/>
                                                    <GradientStop Color="#E9F8EF" Offset="0.58"/>
                                                    <GradientStop Color="#F8FFFB" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="CornerRadius" Value="8"/>
                                        <Setter Property="Padding" Value="10"/>
                                        <Setter Property="Margin" Value="0,0,10,10"/>
                                        <Setter Property="Width" Value="350"/>
                                        <Setter Property="MinHeight" Value="168"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="14"
                                                                  ShadowDepth="2"
                                                                  Direction="270"
                                                                  Color="#55745F"
                                                                  Opacity="0.18"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusClass}" Value="Active">
                                                <Setter Property="BorderBrush" Value="#22C55E"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusClass}" Value="Waiting">
                                                <Setter Property="BorderBrush" Value="#34D399"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusClass}" Value="Success">
                                                <Setter Property="BorderBrush" Value="#16A34A"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusClass}" Value="Error">
                                                <Setter Property="BorderBrush" Value="#22C55E"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusClass}" Value="Blocked">
                                                <Setter Property="BorderBrush" Value="#22C55E"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding UsesPilotDeviceVisual}" Value="True">
                                                <Setter Property="Width" Value="{x:Static core:InterfaceProfileUiPolicy.PilotMonitoringCardWidth}"/>
                                                <Setter Property="MinHeight" Value="248"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style x:Key="MonitoringInputBadgeStyle" TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#D6CDB9"/>
                                        <Setter Property="Background" Value="#FFFDF7"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="CornerRadius" Value="6"/>
                                        <Setter Property="Padding" Value="6"/>
                                        <Setter Property="Margin" Value="0,0,4,6"/>
                                        <Setter Property="MinWidth" Value="{x:Static core:InterfaceProfileUiPolicy.MonitoringInputBadgeMinWidth}"/>
                                        <Setter Property="MaxWidth" Value="{x:Static core:InterfaceProfileUiPolicy.MonitoringInputBadgeMaxWidth}"/>
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="7"
                                                                  ShadowDepth="1"
                                                                  Direction="270"
                                                                  Color="#7B8A80"
                                                                  Opacity="0.18"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusClass}" Value="Active">
                                                <Setter Property="BorderBrush" Value="#7DD3FC"/>
                                                <Setter Property="Background" Value="#F0F9FF"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusClass}" Value="Error">
                                                <Setter Property="BorderBrush" Value="#F97316"/>
                                                <Setter Property="Background" Value="#FFF7ED"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusClass}" Value="Waiting">
                                                <Setter Property="BorderBrush" Value="#E7D8B0"/>
                                                <Setter Property="Background" Value="#FFFDF4"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusClass}" Value="Success">
                                                <Setter Property="BorderBrush" Value="#22C55E"/>
                                                <Setter Property="Background" Value="#ECFDF3"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusClass}" Value="Blocked">
                                                <Setter Property="BorderBrush" Value="#EA580C"/>
                                                <Setter Property="Background" Value="#FFF7ED"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style x:Key="MonitoringSymbolButtonStyle" TargetType="Button">
                                        <Setter Property="Width" Value="30"/>
                                        <Setter Property="Height" Value="28"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontFamily" Value="Segoe UI Symbol, Segoe UI Emoji"/>
                                        <Setter Property="Foreground" Value="#14532D"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border x:Name="ButtonChrome"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                          Margin="{TemplateBinding Padding}"
                                                                          RecognizesAccessKey="True"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ButtonChrome" Property="Background" Value="#1A22C55E"/>
                                                            <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#6634D399"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="ButtonChrome" Property="Background" Value="#3322C55E"/>
                                                            <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#16A34A"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground" Value="#9CA3AF"/>
                                                            <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.55"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Grid.Resources>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="Diese Übersicht zeigt aktive Schnittstellen für die automatische Verarbeitung. XDTBox überwacht die konfigurierten Ordner, sobald die Überwachung läuft."
                                           Foreground="DimGray"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1"
                                           x:Name="ActiveInterfaceProfilesStatusText"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>
                                <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                                    <Button x:Name="StartPeriodicScanButton"
                                            Content="Überwachung starten"
                                            Width="170"
                                            Margin="0,0,8,8"
                                            Click="StartPeriodicScan_Click"/>
                                    <Button x:Name="StopPeriodicScanButton"
                                            Content="Überwachung stoppen"
                                            Width="170"
                                            IsEnabled="False"
                                            Margin="0,0,16,8"
                                            Click="StopPeriodicScan_Click"/>
                                    <TextBlock Text="Status:" FontWeight="Bold" Margin="0,3,4,8"/>
                                    <TextBlock x:Name="PeriodicScanStatusText" Text="Gestoppt" MinWidth="80" Margin="0,3,16,8"/>
                                    <TextBlock Text="Intervall:" FontWeight="Bold" Margin="0,3,4,8"/>
                                    <TextBlock x:Name="PeriodicScanIntervalText" Text="5 Sekunden" MinWidth="80" Margin="0,3,16,8"/>
                                    <TextBlock Text="Letzter Scan:" FontWeight="Bold" Margin="0,3,4,8"/>
                                    <TextBlock x:Name="PeriodicScanLastRunText" Text="-" MinWidth="130" Margin="0,3,16,8"/>
                                    <TextBlock Text="Fertige Paare letzter Scan:" FontWeight="Bold" Margin="0,3,4,8"/>
                                    <TextBlock x:Name="PeriodicScanReadyPairsText" Text="0" MinWidth="40" Margin="0,3,0,8"/>
                                    <TextBlock Text="Gefundene passende Dateipaare werden automatisch verarbeitet, sobald die Überwachung läuft. Importdateien werden nur gemäß Schnittstellenprofil behandelt."
                                               Foreground="DimGray"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,8"/>
                                </WrapPanel>
                                <ItemsControl Grid.Row="3"
                                              x:Name="InterfaceMonitoringCardsItemsControl"
                                              Margin="0,0,0,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource MonitoringCardBorderStyle}">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,5">
                                                        <Button DockPanel.Dock="Right"
                                                                Style="{StaticResource MonitoringSymbolButtonStyle}"
                                                                Content="🗗"
                                                                Margin="8,0,0,0"
                                                                Click="DetachMonitoringCard_Click"
                                                                ToolTip="Fenster abdocken"
                                                                AutomationProperties.Name="Fenster abdocken"/>
                                                        <Button DockPanel.Dock="Right"
                                                                Style="{StaticResource MonitoringSymbolButtonStyle}"
                                                                Content="↺"
                                                                Margin="8,0,0,0"
                                                                Click="ResetMonitoringCard_Click"
                                                                ToolTip="Vorgang zurücksetzen"
                                                                AutomationProperties.Name="Vorgang zurücksetzen"/>
                                                        <StackPanel>
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding UsesPilotDeviceVisual}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="{Binding InterfaceProfileName}"
                                                                       FontSize="11"
                                                                       FontWeight="Bold"
                                                                       Foreground="#18392A"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding InterfaceProfileName}"/>
                                                            <TextBlock Text="{Binding AisName, StringFormat=AIS: {0}}"
                                                                       FontSize="11"
                                                                       Foreground="#46685A"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </DockPanel>

                                                    <Border CornerRadius="8"
                                                            BorderThickness="0"
                                                            Background="#0AF6FFF9"
                                                            Padding="4"
                                                            Margin="0,0,0,7">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding UsesPilotDeviceVisual}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid Height="150">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="190"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="54"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel>
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="Grid.Column" Value="0"/>
                                                                        <Setter Property="Grid.ColumnSpan" Value="1"/>
                                                                        <Setter Property="Grid.Row" Value="0"/>
                                                                        <Setter Property="Grid.RowSpan" Value="2"/>
                                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                                        <Setter Property="Margin" Value="0,0,8,0"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding UsesTextAboveImageLayout}" Value="True">
                                                                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                                                                                <Setter Property="Grid.RowSpan" Value="1"/>
                                                                                <Setter Property="VerticalAlignment" Value="Top"/>
                                                                                <Setter Property="Margin" Value="0,0,8,6"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <TextBlock Text="{Binding EffectiveDeviceTypeDisplay}"
                                                                           FontSize="18"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#102A1F"
                                                                           TextWrapping="Wrap"
                                                                           MaxHeight="50"
                                                                           ToolTip="{Binding DeviceType}"/>
                                                                <TextBlock Text="{Binding InterfaceProfileName}"
                                                                           FontSize="14"
                                                                           Foreground="#102A1F"
                                                                           TextWrapping="Wrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxHeight="58"
                                                                           ToolTip="{Binding InterfaceProfileName}"
                                                                           Margin="0,7,0,0"/>
                                                            </StackPanel>

                                                            <Grid>
                                                                <Grid.Style>
                                                                    <Style TargetType="Grid">
                                                                        <Setter Property="Grid.Column" Value="1"/>
                                                                        <Setter Property="Grid.ColumnSpan" Value="1"/>
                                                                        <Setter Property="Grid.Row" Value="0"/>
                                                                        <Setter Property="Grid.RowSpan" Value="2"/>
                                                                        <Setter Property="Margin" Value="-8,-8,-4,-4"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding UsesTextAboveImageLayout}" Value="True">
                                                                                <Setter Property="Grid.Column" Value="0"/>
                                                                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                                                                                <Setter Property="Grid.Row" Value="1"/>
                                                                                <Setter Property="Grid.RowSpan" Value="1"/>
                                                                                <Setter Property="Margin" Value="0,-2,-4,-4"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Grid.Style>
                                                                <Border Background="#10FFFFFF"
                                                                        CornerRadius="8"/>
                                                                <Image Source="{Binding DeviceImagePath, Converter={StaticResource DeviceImageSourceConverter}}"
                                                                       Stretch="Uniform"
                                                                       RenderOptions.BitmapScalingMode="HighQuality">
                                                                    <Image.Style>
                                                                        <Style TargetType="Image">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasDeviceImage}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Image.Style>
                                                                </Image>
                                                                <TextBlock Text="Kein Gerätebild"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="#6B7280">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasDeviceImage}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>

                                                            <Grid Grid.Column="2"
                                                                  Grid.Row="0"
                                                                  Grid.RowSpan="2"
                                                                  Width="52"
                                                                  Height="52"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Loaded="MonitoringPilotStatusOrb_Loaded"
                                                                  Unloaded="MonitoringPilotStatusOrb_Unloaded"
                                                                  DataContextChanged="MonitoringPilotStatusOrb_DataContextChanged"
                                                                  ToolTip="{Binding CurrentStatus}">
                                                                <Ellipse Width="40"
                                                                         Height="40"
                                                                         Tag="StatusOrb"
                                                                         RenderTransformOrigin="0.5,0.5"
                                                                         Opacity="0.92">
                                                                    <Ellipse.RenderTransform>
                                                                        <ScaleTransform/>
                                                                    </Ellipse.RenderTransform>
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Effect">
                                                                                <Setter.Value>
                                                                                    <DropShadowEffect BlurRadius="16"
                                                                                                      ShadowDepth="2"
                                                                                                      Direction="270"
                                                                                                      Color="#991B1B"
                                                                                                      Opacity="0.34"/>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Setter Property="Fill">
                                                                                <Setter.Value>
                                                                                    <RadialGradientBrush Center="0.34,0.28"
                                                                                                         GradientOrigin="0.22,0.18"
                                                                                                         RadiusX="0.72"
                                                                                                         RadiusY="0.72">
                                                                                        <GradientStop Color="#FEE2E2" Offset="0"/>
                                                                                        <GradientStop Color="#EF4444" Offset="0.42"/>
                                                                                        <GradientStop Color="#B91C1C" Offset="1"/>
                                                                                    </RadialGradientBrush>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ShouldPulseStatusOrb}" Value="True">
                                                                                    <Setter Property="Effect">
                                                                                        <Setter.Value>
                                                                                            <DropShadowEffect BlurRadius="16"
                                                                                                              ShadowDepth="2"
                                                                                                              Direction="270"
                                                                                                              Color="#166534"
                                                                                                              Opacity="0.34"/>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                    <Setter Property="Fill">
                                                                                        <Setter.Value>
                                                                                            <RadialGradientBrush Center="0.34,0.28"
                                                                                                                 GradientOrigin="0.22,0.18"
                                                                                                                 RadiusX="0.72"
                                                                                                                 RadiusY="0.72">
                                                                                                <GradientStop Color="#DCFCE7" Offset="0"/>
                                                                                                <GradientStop Color="#22C55E" Offset="0.42"/>
                                                                                                <GradientStop Color="#15803D" Offset="1"/>
                                                                                            </RadialGradientBrush>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                                <Ellipse Width="40"
                                                                         Height="40"
                                                                         Tag="StatusOrbFlash"
                                                                         Fill="#FFFFFFFF"
                                                                         Opacity="0"/>
                                                                <Ellipse Width="12"
                                                                         Height="8"
                                                                         Fill="#CCFFFFFF"
                                                                         HorizontalAlignment="Left"
                                                                         VerticalAlignment="Top"
                                                                         Margin="13,11,0,0"/>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>

                                                    <Border CornerRadius="6"
                                                            BorderThickness="1"
                                                            BorderBrush="#14532D"
                                                            Background="#082116"
                                                            Padding="6"
                                                            Margin="0,0,0,7">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding UsesPilotDeviceVisual}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid x:Name="MonitoringRadarSurface"
                                                              Height="54"
                                                              ClipToBounds="True"
                                                              Loaded="MonitoringRadar_Loaded"
                                                              Unloaded="MonitoringRadar_Unloaded"
                                                              DataContextChanged="MonitoringRadar_DataContextChanged"
                                                              ToolTip="{Binding ScanIntervalText, StringFormat=Radar-Puls: {0}}">
                                                            <Grid.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#08291D" Offset="0"/>
                                                                    <GradientStop Color="#0F3A2A" Offset="0.55"/>
                                                                    <GradientStop Color="#05130E" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Grid.Background>
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="*"/>
                                                                    <RowDefinition Height="*"/>
                                                                    <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>
                                                                <Border Grid.Row="0" BorderBrush="#1F6B46" BorderThickness="0,0,0,1" Opacity="0.55"/>
                                                                <Border Grid.Row="1" BorderBrush="#1F6B46" BorderThickness="0,0,0,1" Opacity="0.45"/>
                                                            </Grid>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" BorderBrush="#1F6B46" BorderThickness="0,0,1,0" Opacity="0.35"/>
                                                                <Border Grid.Column="1" BorderBrush="#1F6B46" BorderThickness="0,0,1,0" Opacity="0.45"/>
                                                                <Border Grid.Column="2" BorderBrush="#1F6B46" BorderThickness="0,0,1,0" Opacity="0.35"/>
                                                            </Grid>
                                                            <Rectangle Height="46"
                                                                       Width="17"
                                                                       RadiusX="3"
                                                                       RadiusY="3"
                                                                       HorizontalAlignment="Left"
                                                                       VerticalAlignment="Center"
                                                                       Tag="RadarScanBar"
                                                                       Opacity="0.58">
                                                                <Rectangle.RenderTransform>
                                                                    <TranslateTransform/>
                                                                </Rectangle.RenderTransform>
                                                                <Rectangle.Style>
                                                                    <Style TargetType="Rectangle">
                                                                        <Setter Property="Fill">
                                                                            <Setter.Value>
                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                                    <GradientStop Color="#002417" Offset="0"/>
                                                                                    <GradientStop Color="#10B981" Offset="0.38"/>
                                                                                    <GradientStop Color="#BBF7D0" Offset="0.52"/>
                                                                                    <GradientStop Color="#10B981" Offset="0.66"/>
                                                                                    <GradientStop Color="#002417" Offset="1"/>
                                                                                </LinearGradientBrush>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsScanAnimationActive}" Value="False">
                                                                                <Setter Property="Fill" Value="#6B7280"/>
                                                                                <Setter Property="Opacity" Value="0.45"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Rectangle.Style>
                                                            </Rectangle>
                                                            <Border BorderBrush="#5EEA92"
                                                                    BorderThickness="1"
                                                                    Opacity="0.32"/>
                                                            <TextBlock Text="{Binding ScanIntervalText, StringFormat=Scan {0}}"
                                                                       Foreground="#BBF7D0"
                                                                       FontSize="10"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Bottom"
                                                                       Margin="0,0,6,4"/>
                                                        </Grid>
                                                    </Border>

                                                    <WrapPanel Margin="0,0,0,6">
                                                        <WrapPanel.Style>
                                                            <Style TargetType="WrapPanel">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding UsesPilotDeviceVisual}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </WrapPanel.Style>
                                                        <Button Content="−"
                                                                Style="{StaticResource MonitoringSymbolButtonStyle}"
                                                                Margin="0,0,4,4"
                                                                Click="DecreaseMonitoringScanInterval_Click"
                                                                ToolTip="Scanintervall um 1 Sekunde verringern"/>
                                                        <TextBlock Text="{Binding ScanIntervalText, StringFormat=Intervall: {0}}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,2,4,4"/>
                                                        <Button Content="+"
                                                                Style="{StaticResource MonitoringSymbolButtonStyle}"
                                                                Margin="0,0,12,4"
                                                                Click="IncreaseMonitoringScanInterval_Click"
                                                                ToolTip="Scanintervall um 1 Sekunde erhöhen"/>
                                                        <TextBlock Text="{Binding LastScanText, StringFormat=Letzter Scan: {0}}" Margin="0,0,12,4"/>
                                                        <TextBlock Text="{Binding AutomaticProcessingText, StringFormat=Automatik: {0}}" Margin="0,0,0,4"/>
                                                    </WrapPanel>

                                                    <WrapPanel Margin="0,0,0,6"
                                                               HorizontalAlignment="Left">
                                                        <WrapPanel.Style>
                                                            <Style TargetType="WrapPanel">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding UsesPilotDeviceVisual}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </WrapPanel.Style>
                                                        <Button Content="−"
                                                                Style="{StaticResource MonitoringSymbolButtonStyle}"
                                                                Margin="0,0,6,4"
                                                                Click="DecreaseMonitoringScanInterval_Click"
                                                                ToolTip="Scanintervall um 1 Sekunde verringern"/>
                                                        <TextBlock Text="{Binding ScanIntervalText, StringFormat=Intervall: {0}}"
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,2,6,4"/>
                                                        <Button Content="+"
                                                                Style="{StaticResource MonitoringSymbolButtonStyle}"
                                                                Margin="0,0,0,4"
                                                                Click="IncreaseMonitoringScanInterval_Click"
                                                                ToolTip="Scanintervall um 1 Sekunde erhöhen"/>
                                                    </WrapPanel>

                                                    <TextBlock Text="Erwartete Eingänge" FontWeight="Bold" Margin="0,0,0,4"/>
                                                    <ItemsControl ItemsSource="{Binding ExpectedInputs}" Margin="0,0,0,6">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource MonitoringInputBadgeStyle}"
                                                                        ToolTip="{Binding Detail}">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Name}"
                                                                                   FontWeight="Bold"
                                                                                   TextWrapping="NoWrap"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   ToolTip="{Binding Name}"/>
                                                                        <TextBlock Text="{Binding Status}" Foreground="DimGray" TextWrapping="Wrap">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBlock Text="{Binding DisplayDetail}"
                                                                                   Foreground="#4B5563"
                                                                                   FontSize="10"
                                                                                   TextWrapping="Wrap"
                                                                                   MaxHeight="34">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding DisplayDetail}" Value="">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Expander Header="Details"
                                                              IsExpanded="{Binding IsDetailsExpanded, Mode=OneWay}"
                                                              Expanded="MonitoringDetailsExpander_Expanded"
                                                              Collapsed="MonitoringDetailsExpander_Collapsed">
                                                        <StackPanel Margin="0,6,0,0">
                                                            <TextBlock Text="Statusdetails" FontWeight="Bold" Margin="0,0,0,4"/>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="130"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Schnittstelle" FontWeight="Bold" Margin="0,0,8,3"/>
                                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InterfaceProfileName}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Gerät" FontWeight="Bold" Margin="0,0,8,3"/>
                                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeviceName}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Exportprofil" FontWeight="Bold" Margin="0,0,8,3"/>
                                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ExportProfileName}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Letzter Scan" FontWeight="Bold" Margin="0,0,8,3"/>
                                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastScanText}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Automatik" FontWeight="Bold" Margin="0,0,8,3"/>
                                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AutomaticProcessingText}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Anhang" FontWeight="Bold" Margin="0,0,8,3"/>
                                                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AttachmentConfigurationStatus}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Letzte Meldung" FontWeight="Bold" Margin="0,0,8,3"/>
                                                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LastMessage}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Patient" FontWeight="Bold" Margin="0,0,8,0"/>
                                                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding PatientDisplayText}" TextWrapping="Wrap"/>
                                                            </Grid>

                                                            <TextBlock Text="Datei- und Exportinformationen" FontWeight="Bold" Margin="0,2,0,4"/>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="130"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="AIS-Datei" FontWeight="Bold" Margin="0,0,8,3"/>
                                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AisFileName}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Gerätedatei" FontWeight="Bold" Margin="0,0,8,3"/>
                                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeviceFileName}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Anhang" FontWeight="Bold" Margin="0,0,8,3"/>
                                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AttachmentFileName}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Export" FontWeight="Bold" Margin="0,0,8,3"/>
                                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ExportFileName}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Letzter Erfolg" FontWeight="Bold" Margin="0,0,8,0"/>
                                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LastSuccessfulExportText}" TextWrapping="Wrap"/>
                                                            </Grid>

                                                            <TextBlock Text="Ordnerinformationen" FontWeight="Bold" Margin="0,2,0,4"/>
                                                            <ItemsControl ItemsSource="{Binding FolderDetails}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,0,0,3">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="130"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" Margin="0,0,8,0"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </GroupBox>

                        <Expander Header="Monitoring-Ereignisse" Grid.Row="1" IsExpanded="False" Margin="0,0,0,8">
                            <Border Margin="0,8,0,0"
                                    Height="190"
                                    CornerRadius="8"
                                    BorderBrush="#22C55E"
                                    BorderThickness="1"
                                    Padding="8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#071F16" Offset="0"/>
                                        <GradientStop Color="#0B2A1F" Offset="0.55"/>
                                        <GradientStop Color="#06120D" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBox x:Name="MessagesTextBox"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         TextWrapping="Wrap"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Foreground="#CFFFE2"
                                         CaretBrush="#CFFFE2"
                                         Background="#22000000"
                                         BorderBrush="#335EEA92"
                                         BorderThickness="1"
                                         Padding="8"/>
                            </Border>
                        </Expander>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="XDT-Baukasten">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="XdtBaukastenRoot" Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <GroupBox Header="Baukasten-Aktionen">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <UniformGrid Grid.Column="0" Columns="1" Rows="3">
                                    <Button x:Name="XdtBaukastenLoadTemplatePackageButton" Content="Baukasten-Template laden" Margin="0,0,0,8" Click="XdtBaukastenLoadTemplatePackage_Click" />
                                    <Button x:Name="XdtBaukastenImportTemplatePackageButton" Content="Template Paket importieren" Margin="0,0,0,8" Click="XdtBaukastenImportTemplatePackage_Click" />
                                    <Button x:Name="XdtBaukastenLoadDeviceButton" Content="Gerät laden" Click="XdtBaukastenLoadDevice_Click" />
                                </UniformGrid>

                                <UniformGrid Grid.Column="2" Columns="1" Rows="3">
                                    <Button x:Name="XdtBaukastenSaveTemplateButton" Content="Konfiguration als Template speichern" Margin="0,0,0,8" Click="XdtBaukastenSaveTemplate_Click" />
                                    <Button x:Name="XdtBaukastenExportTemplatePackageButton" Content="Template Paket exportieren" Margin="0,0,0,8" Click="XdtBaukastenExportTemplatePackage_Click" />
                                    <Button x:Name="XdtBaukastenNewDeviceButton" Content="Neues Gerät anlegen" Click="XdtBaukastenNewDevice_Click" />
                                </UniformGrid>
                                <Border Grid.Row="1"
                                        Grid.ColumnSpan="3"
                                        Margin="0,10,0,0"
                                        Padding="10,8"
                                        Background="{StaticResource XdtBoxPanelBackgroundBrush}"
                                        BorderBrush="{StaticResource XdtBoxBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock x:Name="XdtBaukastenTopStatusText"
                                                   Foreground="{StaticResource XdtBoxMutedTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Text="Baukasten bereit. Bitte Profile und Testdaten laden." />
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="12"
                                                   Foreground="{StaticResource XdtBoxMutedTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Text="Baukastenmodus: Modellabweichungen werden als Warnung angezeigt, blockieren die Vorschau aber nicht. Die produktive Verarbeitung prüft strenger." />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="1" Header="Geräteidentität">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="XdtBaukastenDeviceImageContainer"
                                        BorderBrush="{StaticResource XdtBoxBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Background="White"
                                        Padding="10"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="XdtBaukastenDeviceImage_MouseLeftButtonUp">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="ToolTip" Value="Gerätebild auswählen oder austauschen" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=XdtBaukastenDeviceImagePathTextBox}" Value="">
                                                    <Setter Property="ToolTip" Value="Kein Gerätebild hinterlegt. Klicken, um ein Bild auszuwählen." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="150" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Image x:Name="XdtBaukastenDeviceImage"
                                               Source="{Binding Text, ElementName=XdtBaukastenDeviceImagePathTextBox, Converter={StaticResource DeviceImageSourceConverter}}"
                                               Stretch="Uniform" />
                                        <TextBlock x:Name="XdtBaukastenDeviceImagePlaceholder"
                                                   Text="Geräte Bild&#x0a;&#x0a;Mit Klick austauschbar"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource XdtBoxMutedTextBrush}" />
                                        <TextBox x:Name="XdtBaukastenDeviceImagePathTextBox" Visibility="Collapsed" />
                                        <TextBlock Grid.Row="1"
                                                   Text="Bild per Klick austauschbar"
                                                   Margin="0,8,0,0"
                                                   TextAlignment="Center"
                                                   Foreground="{StaticResource XdtBoxMutedTextBrush}" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Column="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="AIS-Profil:" FontWeight="SemiBold" Margin="0,0,8,8" />
                                    <ComboBox x:Name="XdtBaukastenAisProfileComboBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" DisplayMemberPath="Metadata.Name" SelectionChanged="XdtBaukastenAisProfileComboBox_SelectionChanged" Margin="0,0,0,8" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Geräteprofil:" FontWeight="SemiBold" Margin="0,0,8,8" />
                                    <ComboBox x:Name="XdtBaukastenDeviceProfileComboBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" DisplayMemberPath="Metadata.Name" SelectionChanged="XdtBaukastenDeviceProfileComboBox_SelectionChanged" Margin="0,0,0,8" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Gerätename:" FontWeight="SemiBold" Margin="0,0,8,6" />
                                    <TextBlock x:Name="XdtBaukastenDeviceNameText" Grid.Row="2" Grid.Column="1" Margin="0,0,16,6" Text="Kein Gerät geladen" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Hersteller:" FontWeight="SemiBold" Margin="0,0,8,6" />
                                    <TextBlock x:Name="XdtBaukastenManufacturerText" Grid.Row="2" Grid.Column="3" Margin="0,0,0,6" Text="-" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Verbindung:" FontWeight="SemiBold" Margin="0,0,8,6" />
                                    <TextBlock x:Name="XdtBaukastenConnectionKindText" Grid.Row="3" Grid.Column="1" Margin="0,0,16,6" Text="-" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Gerätetyp:" FontWeight="SemiBold" Margin="0,0,8,6" />
                                    <TextBlock x:Name="XdtBaukastenDeviceTypeText" Grid.Row="3" Grid.Column="3" Margin="0,0,0,6" Text="-" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Bidirektional:" FontWeight="SemiBold" Margin="0,0,8,6" />
                                    <TextBlock x:Name="XdtBaukastenBidirectionalText" Grid.Row="4" Grid.Column="1" Margin="0,0,16,6" Text="-" />
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Geräteparser:" FontWeight="SemiBold" Margin="0,0,8,6" />
                                    <TextBlock x:Name="XdtBaukastenParserText" Grid.Row="4" Grid.Column="3" Margin="0,0,0,6" Text="-" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Profilname:" FontWeight="SemiBold" Margin="0,0,8,6" />
                                    <TextBlock x:Name="XdtBaukastenProfileNameText" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Text="-" />
                                    <Button x:Name="XdtBaukastenDeviceTechnicalProfileButton"
                                            Grid.Row="6"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Content="Gerätesteckbrief"
                                            Width="190"
                                            HorizontalAlignment="Left"
                                            Margin="0,10,0,0"
                                            Click="ShowXdtBaukastenDeviceTechnicalProfile_Click"
                                            ToolTip="Öffnet den Geräte-Steckbrief des aktuell gewählten Baukasten-Geräteprofils."/>
                                </Grid>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="2" Header="Testdaten und Rohdaten">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <Button x:Name="XdtBaukastenLoadAisOrSerialButton" Content="AIS Datei laden" MinWidth="180" Margin="0,0,12,0" Click="XdtBaukastenLoadAisOrSerial_Click" />
                                    <Button x:Name="XdtBaukastenLoadAttachmentButton" Content="Dateianhang laden" MinWidth="180" Margin="0,0,12,0" Click="XdtBaukastenLoadAttachment_Click" />
                                    <Button x:Name="XdtBaukastenLoadDeviceFileButton" Content="Gerätedatei laden" MinWidth="180" Click="XdtBaukastenLoadDeviceFile_Click" />
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <GroupBox x:Name="XdtBaukastenPrimaryRawGroupBox" Header="Anzeige Rohdaten von AIS Datei">
                                        <TextBox x:Name="XdtBaukastenAisRawTextBox"
                                                 MinHeight="220"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 FontFamily="Consolas"
                                                 TextWrapping="NoWrap"
                                                 IsReadOnly="True" />
                                    </GroupBox>
                                    <GroupBox Grid.Column="2" Header="Anzeige Rohdaten vom Gerät">
                                        <TextBox x:Name="XdtBaukastenDeviceRawTextBox"
                                                 MinHeight="220"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 FontFamily="Consolas"
                                                 TextWrapping="NoWrap"
                                                 IsReadOnly="True" />
                                    </GroupBox>
                                </Grid>

                                <TextBlock x:Name="XdtBaukastenAttachmentStatusText" Grid.Row="2" Margin="0,8,0,0" Foreground="{StaticResource XdtBoxMutedTextBrush}" Text="Kein Dateianhang geladen." />
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="3" Header="Mapping, Verarbeitung und Ergebnis">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="XdtBaukastenChooseExportProfileButton" Content="Mapping / Exportprofil" MinWidth="180" Margin="0,0,12,0" Click="XdtBaukastenChooseExportProfile_Click" />
                                    <ComboBox x:Name="XdtBaukastenExportProfileComboBox" MinWidth="380" DisplayMemberPath="Metadata.Name" SelectionChanged="XdtBaukastenExportProfileComboBox_SelectionChanged" />
                                    <Button x:Name="XdtBaukastenStartProcessingButton" Content="Verarbeitung starten" MinWidth="180" Margin="12,0,0,0" Click="XdtBaukastenStartProcessing_Click" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Ansicht:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                                    <ComboBox x:Name="XdtBaukastenResultViewComboBox" MinWidth="180" SelectedIndex="0" SelectionChanged="XdtBaukastenResultViewComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Roh-XDT" Tag="RawXdt" />
                                        <ComboBoxItem Content="Ansicht im AIS" Tag="AisView" />
                                        <ComboBoxItem Content="Geräteausgabe" Tag="DeviceOutput" />
                                        <ComboBoxItem Content="Diagnose" Tag="Diagnostics" />
                                    </ComboBox>
                                </StackPanel>

                                <TextBlock x:Name="XdtBaukastenStatusText" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,8" Foreground="{StaticResource XdtBoxMutedTextBrush}" Text="Baukasten bereit. Bitte Profile und Testdaten laden." />

                                <GroupBox x:Name="XdtBaukastenResultGroupBox" Grid.Row="2" Grid.ColumnSpan="2" Header="Roh-XDT-Ausgabe an das AIS">
                                    <Grid>
                                        <DataGrid x:Name="XdtBaukastenResultLinesGrid"
                                                  MinHeight="260"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  FontFamily="Consolas"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  SelectionMode="Extended"
                                                  SelectionUnit="FullRow">
                                            <DataGrid.RowStyle>
                                                <Style TargetType="{x:Type DataGridRow}">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                            <Setter Property="Background" Value="#FFF4C2" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                            <Setter Property="Foreground" Value="#8A4B00" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="54" />
                                                <DataGridTextColumn Header="Ausgabe" Binding="{Binding Text}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBox x:Name="XdtBaukastenResultTextBox"
                                                 Visibility="Collapsed"
                                                 IsReadOnly="True" />
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="4" Header="Konfiguration Exportregeln">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border x:Name="XdtBaukastenRuleDirectionPanel"
                                        Grid.Row="0"
                                        Margin="0,0,0,8"
                                        Padding="8"
                                        Background="{StaticResource XdtBoxPanelBackgroundBrush}"
                                        BorderBrush="{StaticResource XdtBoxBorderBrush}"
                                        BorderThickness="1">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="Richtung:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <RadioButton x:Name="XdtBaukastenRuleDirectionAisRadioButton"
                                                         Content="Export an AIS"
                                                         GroupName="XdtBaukastenRuleDirection"
                                                         IsChecked="True"
                                                         Margin="0,0,16,0"
                                                         VerticalAlignment="Center"
                                                         Checked="XdtBaukastenRuleDirection_Checked" />
                                            <RadioButton x:Name="XdtBaukastenRuleDirectionDeviceOutputRadioButton"
                                                         Content="Export an Gerät"
                                                         GroupName="XdtBaukastenRuleDirection"
                                                         Margin="0,0,16,0"
                                                         VerticalAlignment="Center"
                                                         Checked="XdtBaukastenRuleDirection_Checked" />
                                        </StackPanel>
                                        <TextBlock x:Name="XdtBaukastenRuleDirectionHintText"
                                                   Text="Export an AIS ist aktiv."
                                                   Foreground="{StaticResource XdtBoxMutedTextBrush}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>

                                <DataGrid x:Name="XdtBaukastenExportRulesGrid"
                                          Grid.Row="1"
                                          MinHeight="220"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          SelectionChanged="XdtBaukastenExportRulesGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:Name="XdtBaukastenRuleNumberColumn" Header="#" Binding="{Binding RowNumber}" Width="46" />
                                        <DataGridTextColumn Header="Aktiv" Binding="{Binding Rule.IsEnabled}" Width="70" />
                                        <DataGridTextColumn x:Name="XdtBaukastenRuleTargetColumn" Header="Feld" Binding="{Binding Rule.TargetFieldCode}" Width="130" />
                                        <DataGridTextColumn x:Name="XdtBaukastenRuleTargetNameColumn" Header="Name" Binding="{Binding Rule.TargetName}" Width="180" />
                                        <DataGridTextColumn Header="SourcePath" Binding="{Binding Rule.SourcePath}" Width="220" />
                                        <DataGridTextColumn Header="Template" Binding="{Binding Rule.OutputTemplate}" Width="*" />
                                        <DataGridTemplateColumn Header="" Width="54">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="🗑"
                                                            Tag="{Binding Rule}"
                                                            ToolTip="Exportregel aus der Baukasten-Arbeitskopie löschen"
                                                            Click="XdtBaukastenDeleteExportRule_Click" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Button x:Name="XdtBaukastenAddExportRuleButton"
                                        Grid.Row="2"
                                        Content="+"
                                        Width="44"
                                        HorizontalAlignment="Right"
                                        Margin="0,8,4,0"
                                        ToolTip="Neue Exportregel in der Baukasten-Arbeitskopie hinzufügen"
                                        Click="XdtBaukastenAddExportRule_Click" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="5" Header="Exportregel Entwurf">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="XdtBaukastenDraftTargetLabel" Grid.Row="0" Grid.Column="0" Text="Ziel-Feld:" FontWeight="SemiBold" Margin="0,0,8,8" />
                                <TextBox x:Name="XdtBaukastenDraftTargetFieldCodeTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,16,8" TextChanged="XdtBaukastenDraftRuleTextBox_TextChanged" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Zielname:" FontWeight="SemiBold" Margin="0,0,8,8" />
                                <TextBox x:Name="XdtBaukastenDraftTargetNameTextBox" Grid.Row="0" Grid.Column="3" Margin="0,0,0,8" TextChanged="XdtBaukastenDraftRuleTextBox_TextChanged" />

                                <TextBlock x:Name="XdtBaukastenDraftSourceLabel" Grid.Row="1" Grid.Column="0" Text="SourcePath:" FontWeight="SemiBold" Margin="0,0,8,8" />
                                <TextBox x:Name="XdtBaukastenDraftSourcePathTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" TextChanged="XdtBaukastenDraftRuleTextBox_TextChanged" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Regeltext:" FontWeight="SemiBold" Margin="0,0,8,8" />
                                <TextBox x:Name="XdtBaukastenDraftOutputTemplateTextBox"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="3"
                                         MinHeight="88"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         TextChanged="XdtBaukastenDraftRuleTextBox_TextChanged"
                                         TextWrapping="Wrap" />

                                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="XdtBaukastenApplyDraftRuleButton" Content="Entwurf in Arbeitskopie übernehmen" MinWidth="240" Margin="0,0,12,0" Click="XdtBaukastenApplyDraftRule_Click" />
                                    <TextBlock x:Name="XdtBaukastenDraftStatusText" VerticalAlignment="Center" Foreground="{StaticResource XdtBoxMutedTextBrush}" Text="Keine Exportregel ausgewählt." />
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="6" Header="Verfügbare Platzhalter">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <GroupBox Header="AIS-/Patienten-Platzhalter">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                                        <ItemsControl x:Name="XdtBaukastenAisPlaceholderItems">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button ToolTip="{Binding Description}" Tag="{Binding Token}" Margin="0,0,0,6" HorizontalContentAlignment="Stretch" Click="XdtBaukastenPlaceholder_Click">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding ExampleValue}"
                                                                       Margin="12,0,0,0"
                                                                       HorizontalAlignment="Right"
                                                                       FontFamily="Consolas"
                                                                       Foreground="{StaticResource XdtBoxMutedTextBrush}" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </GroupBox>

                                <GroupBox Grid.Column="2" Header="Geräte-/Messwert-Platzhalter">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                                        <ItemsControl x:Name="XdtBaukastenDevicePlaceholderItems">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button ToolTip="{Binding Description}" Tag="{Binding Token}" Margin="0,0,0,6" HorizontalContentAlignment="Stretch" Click="XdtBaukastenPlaceholder_Click">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding ExampleValue}"
                                                                       Margin="12,0,0,0"
                                                                       HorizontalAlignment="Right"
                                                                       FontFamily="Consolas"
                                                                       Foreground="{StaticResource XdtBoxMutedTextBrush}" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </GroupBox>

                                <GroupBox Grid.Column="4" Header="Ausgabe-an-Gerät-Platzhalter">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                                        <ItemsControl x:Name="XdtBaukastenDeviceOutputPlaceholderItems">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button ToolTip="{Binding Description}" Tag="{Binding Token}" Margin="0,0,0,6" HorizontalContentAlignment="Stretch" Click="XdtBaukastenPlaceholder_Click">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding ExampleValue}"
                                                                       Margin="12,0,0,0"
                                                                       HorizontalAlignment="Right"
                                                                       FontFamily="Consolas"
                                                                       Foreground="{StaticResource XdtBoxMutedTextBrush}" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </GroupBox>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Profilverwaltung">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="5"
                                Padding="10"
                                Margin="0,0,0,10"
                                BorderBrush="{StaticResource XdtBoxBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Background="{StaticResource XdtBoxPanelBackgroundBrush}">
                            <StackPanel>
                                <TextBlock Text="Profilverwaltung"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource XdtBoxDarkTextBrush}" />
                                <TextBlock Text="Zentrale Übersicht für AIS-, Geräte-, Export-, Schnittstellen- und Templateprofile. Der XDT-Baukasten bleibt Entwurf, Test und Vorschau."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource XdtBoxMutedTextBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <GroupBox Grid.Row="1" Grid.Column="0" Header="Übersicht / Filter">
                            <StackPanel Margin="8">
                                <TextBlock Text="Suche" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox x:Name="ProfileManagementSearchTextBox"
                                         Margin="0,0,0,10"
                                         TextChanged="ProfileManagementFilter_Changed"
                                         ToolTip="Durchsucht Name, Typ, Hersteller/AIS und Verwendungen." />

                                <TextBlock Text="Quelle" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ComboBox x:Name="ProfileManagementScopeFilterComboBox"
                                          SelectedValuePath="Tag"
                                          SelectedValue="All"
                                          Margin="0,0,0,10"
                                          SelectionChanged="ProfileManagementFilter_Changed">
                                    <ComboBoxItem Content="Alle" Tag="All" />
                                    <ComboBoxItem Content="BuiltIn" Tag="BuiltIn" />
                                    <ComboBoxItem Content="UserDefined" Tag="UserDefined" />
                                    <ComboBoxItem Content="Lokal" Tag="Lokal" />
                                </ComboBox>

                                <TextBlock Text="Profiltyp" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ComboBox x:Name="ProfileManagementKindFilterComboBox"
                                          SelectedValuePath="Tag"
                                          SelectedValue="All"
                                          Margin="0,0,0,12"
                                          SelectionChanged="ProfileManagementFilter_Changed">
                                    <ComboBoxItem Content="Alle" Tag="All" />
                                    <ComboBoxItem Content="AIS-Profile" Tag="AisProfile" />
                                    <ComboBoxItem Content="Geräteprofile" Tag="DeviceProfile" />
                                    <ComboBoxItem Content="Exportprofile" Tag="ExportProfile" />
                                    <ComboBoxItem Content="Schnittstellenprofile" Tag="InterfaceProfile" />
                                    <ComboBoxItem Content="Templatepakete" Tag="TemplatePackage" />
                                    <ComboBoxItem Content="Baukasten-Templates" Tag="XdtBaukastenTemplate" />
                                    <ComboBoxItem Content="Wartung" Tag="Maintenance" />
                                </ComboBox>

                                <Button Content="Profile neu laden / BuiltIns reparieren"
                                        Margin="0,0,0,8"
                                        Click="RefreshProfileManagement_Click"
                                        ToolTip="Lädt den Profilkatalog neu. BuiltIn-Reparaturen laufen über den Katalogservice; UserDefined-Profile bleiben unverändert." />
                                <TextBlock x:Name="ProfileManagementStatusText"
                                           Text="Keine Profile geladen."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource XdtBoxMutedTextBrush}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="1" Grid.Column="2" Header="Profile und lokale Templates">
                            <DataGrid x:Name="ProfileManagementGrid"
                                      Margin="8"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      SelectionChanged="ProfileManagementGrid_SelectionChanged"
                                      MinHeight="420"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" MinWidth="220" Width="*" />
                                    <DataGridTextColumn Header="Typ" Binding="{Binding Type}" MinWidth="120" Width="130" />
                                    <DataGridTextColumn Header="Hersteller / AIS / Gerät" Binding="{Binding Owner}" MinWidth="180" Width="200" />
                                    <DataGridTextColumn Header="BuiltIn/UserDefined" Binding="{Binding Scope}" MinWidth="130" Width="150" />
                                    <DataGridTextColumn Header="Aktiv genutzt" Binding="{Binding ActiveUsage}" MinWidth="120" Width="130" />
                                    <DataGridTextColumn Header="Verwendet von" Binding="{Binding UsedBy}" MinWidth="240" Width="260" />
                                    <DataGridTextColumn Header="Zuletzt geändert" Binding="{Binding UpdatedAt}" MinWidth="130" Width="150" />
                                    <DataGridTextColumn Header="Aktionen" Binding="{Binding Actions}" MinWidth="280" Width="320" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <Grid Grid.Row="1" Grid.Column="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <GroupBox Grid.Row="0" Header="Aktionen">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Neu anlegen / laden"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6" />
                                    <Button x:Name="ProfileManagementNewAisButton"
                                            Content="Neues AIS anlegen"
                                            Margin="0,0,0,6"
                                            Click="ProfileManagementNewAis_Click"
                                            ToolTip="Legt ein neues UserDefined-AIS-Profil an. BuiltIns bleiben unverändert." />
                                    <Button x:Name="ProfileManagementLoadDeviceButton"
                                            Content="Gerät laden / Bild pflegen"
                                            Margin="0,0,0,6"
                                            Click="ProfileManagementLoadDevice_Click"
                                            ToolTip="Öffnet den Gerätedialog. Bilder werden als lokale Overrides gespeichert; Originalprofile werden nicht überschrieben." />
                                    <Button x:Name="ProfileManagementNewExportButton"
                                            Content="Neues Exportprofil aus Vorlage"
                                            Margin="0,0,0,6"
                                            Click="ProfileManagementNewExport_Click"
                                            ToolTip="Erstellt eine UserDefined-Kopie eines Exportprofils als Startpunkt für den Baukasten." />
                                    <Button x:Name="ProfileManagementNewInterfaceButton"
                                            Content="Neues Schnittstellenprofil"
                                            Margin="0,0,0,10"
                                            Click="ProfileManagementNewInterface_Click"
                                            ToolTip="Legt eine neue konkrete Praxisanbindung als UserDefined-Schnittstellenprofil an." />

                                    <TextBlock Text="Templates"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6" />
                                    <Button x:Name="ProfileManagementNewTemplateButton"
                                            Content="Baukasten-Template erstellen"
                                            Margin="0,0,0,6"
                                            Click="ProfileManagementNewTemplate_Click"
                                            ToolTip="Wechselt in den XDT-Baukasten. Dort wird die aktuelle Arbeitskopie als Template gespeichert." />
                                    <Button x:Name="ProfileManagementImportTemplatePackageButton"
                                            Content="Templatepaket importieren"
                                            Margin="0,0,0,6"
                                            Click="ProfileManagementImportTemplatePackage_Click"
                                            ToolTip="Importiert ein Templatepaket über den sicheren Baukasten-Importdialog mit Konfliktprüfung." />
                                    <Button x:Name="ProfileManagementExportTemplateButton"
                                            Content="Ausgewähltes Template/Paket exportieren"
                                            Margin="0,0,0,10"
                                            Click="ProfileManagementExportTemplate_Click"
                                            ToolTip="Kopiert lokale Baukasten-Templates oder Templatepakete an einen Zielort. Schnittstellenprofile werden als Templatepaket exportiert." />

                                    <TextBlock Text="Ausgewählter Eintrag"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6" />
                                    <Button x:Name="ProfileManagementOpenWorkbenchButton"
                                            Content="Im XDT-Baukasten öffnen"
                                            Margin="0,0,0,6"
                                            Click="ProfileManagementOpenWorkbench_Click"
                                            ToolTip="Lädt AIS-, Geräte-, Export- oder Baukasten-Template-Auswahl in den XDT-Baukasten." />
                                    <Button x:Name="ProfileManagementOpenInterfaceButton"
                                            Content="Im Schnittstellenprofil öffnen"
                                            Margin="0,0,0,6"
                                            Click="ProfileManagementOpenInterface_Click"
                                            ToolTip="Springt zum Tab Schnittstellenprofile und wählt dieses Schnittstellenprofil aus." />
                                    <Button x:Name="ProfileManagementRenameButton"
                                            Content="Umbenennen"
                                            Margin="0,0,0,6"
                                            Click="ProfileManagementRename_Click"
                                            ToolTip="Nur UserDefined-Profile können umbenannt werden." />
                                    <Button x:Name="ProfileManagementDuplicateButton"
                                            Content="Als UserDefined-Kopie duplizieren"
                                            Margin="0,0,0,6"
                                            Click="ProfileManagementDuplicate_Click"
                                            ToolTip="BuiltIn- und UserDefined-Profile können als neue UserDefined-Kopie gespeichert werden." />
                                    <Button x:Name="ProfileManagementDeleteButton"
                                            Content="Löschen"
                                            Margin="0,0,0,6"
                                            Click="ProfileManagementDelete_Click"
                                            ToolTip="Löscht nur erlaubte UserDefined-Profile oder lokale Template-Dateien nach Bestätigung." />
                                    <Button Content="Wartung ausführen"
                                            Click="ProfileManagementRepairBuiltIns_Click"
                                            ToolTip="Lädt den Katalog neu und repariert BuiltIn-Profile über den bestehenden Katalogservice. UserDefined bleibt unverändert." />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Grid.Row="2" Header="Details und Aktionen">
                                <TextBox x:Name="ProfileManagementDetailsTextBox"
                                         Margin="8"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Height="160"
                                         Text="Bitte einen Eintrag auswählen." />
                            </GroupBox>
                        </Grid>

                        <Border Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="5"
                                Margin="0,10,0,0"
                                Padding="10,8"
                                BorderBrush="{StaticResource XdtBoxBorderBrush}"
                                BorderThickness="1"
                                Background="{StaticResource XdtBoxPanelBackgroundBrush}">
                            <TextBlock Text="Abgrenzung: XDT-Baukasten = Entwurf/Test/Vorschau. Profilverwaltung = Übersicht, Umbenennen, Löschen, Duplizieren und Wartung. Schnittstellenprofile = konkrete Praxisanbindung."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource XdtBoxMutedTextBrush}" />
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Schnittstellenprofile">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

