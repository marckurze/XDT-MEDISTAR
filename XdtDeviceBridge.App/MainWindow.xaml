                                            <ComboBoxItem Content="Alle ausgewählten Werte ohne ID" Tag="FullWithoutId"/>
                                            <ComboBoxItem Content="RT-Referenz ohne ID (AR/AL)" Tag="ReferenceWithoutIdArAl"/>
                                            <ComboBoxItem Content="Nur Autoref ohne ID" Tag="ArOnlyWithoutId"/>
                                            <ComboBoxItem Content="Nur Lensmeter ohne ID" Tag="LmOnlyWithoutId"/>
                                            <ComboBoxItem Content="Minimal rechts" Tag="MinimalRightOnly"/>
                                            <ComboBoxItem Content="RT-3100 Praxisvariante (getestet)" Tag="LegacyRt3100DirectFrame"/>
