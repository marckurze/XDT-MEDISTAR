                                                          MinHeight="120"
                                                          MaxHeight="220">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Schweregrad" Binding="{Binding Severity}" Width="100"/>
                                                        <DataGridTextColumn Header="Bereich" Binding="{Binding Area}" Width="150"/>
                                                        <DataGridTextColumn Header="Prüfung" Binding="{Binding Message}" Width="*"/>
                                                        <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                        </Expander>
                                    </Grid>
                                </Expander>
                                </StackPanel>
                             </Grid>
                         </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Notizen Techniker">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <ToggleButton x:Name="TechnicianWhiteboardTextModeButton"
                                      Content="T"
                                      FontWeight="Bold"
                                      Width="48"
                                      Margin="0,0,8,8"
                                      Click="TechnicianWhiteboardTextMode_Click"
                                      ToolTip="Textmodus: Auf das Whiteboard klicken und direkt schreiben."/>
                        <ToggleButton x:Name="TechnicianWhiteboardHandModeButton"
                                      Content="↔"
                                      FontWeight="Bold"
                                      Width="48"
                                      Margin="0,0,8,8"
                                      Click="TechnicianWhiteboardHandMode_Click"
                                      ToolTip="Handmodus: Elemente auswählen, verschieben und skalieren."/>
                        <Button Content="Bild einfügen" Width="120" Margin="0,0,8,8" Style="{StaticResource XdtBoxSecondaryButtonStyle}" Click="TechnicianWhiteboardAddImage_Click"/>
                        <Button Content="Aktivierte Geräte einfügen" Width="190" Margin="0,0,8,8" Style="{StaticResource XdtBoxSecondaryButtonStyle}" Click="TechnicianWhiteboardInsertActiveDevices_Click"/>
                        <Button Content="Speichern" Width="110" Margin="0,0,8,8" Style="{StaticResource XdtBoxSecondaryButtonStyle}" Click="TechnicianWhiteboardSave_Click"/>
                        <Button Content="Als PDF speichern" Width="150" Margin="0,0,18,8" Style="{StaticResource XdtBoxSecondaryButtonStyle}" Click="TechnicianWhiteboardExportPdf_Click"/>
                        <CheckBox x:Name="TechnicianWhiteboardBoldCheckBox" Content="Fett" Margin="0,4,10,8" Checked="TechnicianWhiteboardFormatting_Changed" Unchecked="TechnicianWhiteboardFormatting_Changed"/>
                        <CheckBox x:Name="TechnicianWhiteboardItalicCheckBox" Content="Kursiv" Margin="0,4,10,8" Checked="TechnicianWhiteboardFormatting_Changed" Unchecked="TechnicianWhiteboardFormatting_Changed"/>
                        <CheckBox x:Name="TechnicianWhiteboardUnderlineCheckBox" Content="Unterstrichen" Margin="0,4,10,8" Checked="TechnicianWhiteboardFormatting_Changed" Unchecked="TechnicianWhiteboardFormatting_Changed"/>
                        <TextBlock Text="Schriftgröße:" VerticalAlignment="Center" Margin="0,0,6,8"/>
                        <ComboBox x:Name="TechnicianWhiteboardFontSizeComboBox"
                                  Width="72"
                                  SelectedValuePath="Tag"
                                  SelectedValue="16"
                                  SelectionChanged="TechnicianWhiteboardFormatting_Changed"
                                  Margin="0,0,8,8">
                            <ComboBoxItem Content="12" Tag="12"/>
                            <ComboBoxItem Content="14" Tag="14"/>
                            <ComboBoxItem Content="16" Tag="16"/>
                            <ComboBoxItem Content="18" Tag="18"/>
                            <ComboBoxItem Content="22" Tag="22"/>
                            <ComboBoxItem Content="28" Tag="28"/>
                            <ComboBoxItem Content="36" Tag="36"/>
                        </ComboBox>
                        <ComboBox x:Name="TechnicianWhiteboardColorComboBox"
                                  Width="120"
                                  SelectedValuePath="Tag"
                                  SelectedValue="#24313A"
                                  SelectionChanged="TechnicianWhiteboardFormatting_Changed"
                                  Margin="0,0,8,8">
                            <ComboBoxItem Content="Dunkel" Tag="#24313A"/>
                            <ComboBoxItem Content="Blau" Tag="#0B4D93"/>
                            <ComboBoxItem Content="Türkis" Tag="#0E8E92"/>
                            <ComboBoxItem Content="Rot" Tag="#8B1E1E"/>
                        </ComboBox>
                    </WrapPanel>
                    <Border Grid.Row="1"
                            Style="{StaticResource XdtBoxWhiteboardSurfaceStyle}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Canvas x:Name="TechnicianWhiteboardCanvas"
                                    Width="1600"
                                    Height="1000"
                                    Background="{StaticResource XdtBoxWhiteboardBrush}"
                                    AllowDrop="True"
                                    Drop="TechnicianWhiteboardCanvas_Drop"
                                    PreviewMouseLeftButtonDown="TechnicianWhiteboardCanvas_PreviewMouseLeftButtonDown"
                                    PreviewMouseRightButtonDown="TechnicianWhiteboardCanvas_PreviewMouseRightButtonDown">
                                <Canvas.ContextMenu>
                                    <ContextMenu Opened="TechnicianWhiteboardContextMenu_Opened">
                                        <MenuItem x:Name="TechnicianWhiteboardCopyMenuItem"
                                                  Header="Kopieren"
                                                  Click="TechnicianWhiteboardCopy_Click"/>
                                        <MenuItem x:Name="TechnicianWhiteboardPasteMenuItem"
                                                  Header="Einfügen"
                                                  Click="TechnicianWhiteboardPaste_Click"/>
                                        <Separator/>
                                        <MenuItem x:Name="TechnicianWhiteboardRemoveMenuItem"
                                                  Header="Entfernen"
                                                  Click="TechnicianWhiteboardRemove_Click"/>
                                    </ContextMenu>
                                </Canvas.ContextMenu>
                            </Canvas>
                        </ScrollViewer>
                    </Border>
                    <TextBlock Grid.Row="2"
                               x:Name="TechnicianWhiteboardStatusText"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource XdtBoxMutedTextBrush}"
                               Text="Techniker-Notizen werden als Kundendaten gespeichert. Es werden keine Patientendaten automatisch eingefügt."/>
                </Grid>
            </TabItem>

            <TabItem Header="Sicherung/Umzug">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <GroupBox Header="Sicherung erstellen" Grid.Row="0" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="Erstellt eine vollständige XDTBox-Konfigurationssicherung mit Profilen, lokalen Gerätebildern, Lizenz-Kundendaten und optional importierter Lizenzdatei. Es werden keine Patientendaten oder Messdateien gesichert."
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>
                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Zielpfad:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" x:Name="BackupTargetPathTextBox" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="Auswählen" Width="110" Click="SelectBackupTarget_Click"/>
                                </Grid>
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button Content="Sicherung erstellen" Width="160" Margin="0,0,8,0" Click="CreateBackup_Click"/>
                                    <TextBlock x:Name="BackupCreateStatusText"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource XdtBoxMutedTextBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Sicherung wiederherstellen" Grid.Row="1" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="Wiederherstellung ersetzt lokale XDTBox-Konfigurationen. Bitte stellen Sie sicher, dass keine Verarbeitung läuft."
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>
                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Sicherungsdatei:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" x:Name="BackupRestorePathTextBox" IsReadOnly="True" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="Sicherung auswählen" Width="150" Click="SelectBackupRestoreFile_Click"/>
                                </Grid>
                                <Border Grid.Row="2"
                                        BorderBrush="{StaticResource XdtBoxBorderBrush}"
                                        BorderThickness="1"
                                        Background="{StaticResource XdtBoxPanelBackgroundBrush}"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <TextBlock x:Name="BackupManifestTextBlock"
                                               Text="Keine Sicherung ausgewählt."
                                               TextWrapping="Wrap"/>
                                </Border>
                                <StackPanel Grid.Row="3" Orientation="Horizontal">
                                    <Button Content="Wiederherstellen" Width="150" Margin="0,0,8,0" Click="RestoreBackup_Click"/>
                                    <TextBlock x:Name="BackupRestoreStatusText"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource XdtBoxMutedTextBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <Border Grid.Row="2"
                                BorderBrush="#E0A126"
                                BorderThickness="1"
                                Background="#FFF4D6"
                                CornerRadius="4"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="Hardwareumzug"
                                           FontWeight="Bold"
                                           Foreground="#5A3A00"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Bei Hardwaretausch bitte neue Lizenz anfordern. Karenzzeit 7 Tage ab Umzug der Hardware."
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="#5A3A00"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Eine wiederhergestellte Lizenz kann auf neuer Hardware ungültig sein. Erzeugen Sie nach dem Umzug eine neue Lizenzanforderung."
                                           TextWrapping="Wrap"
                                           Foreground="#5A3A00"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Lizenz">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <GroupBox Header="Lizenzstatus" Grid.Row="0" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Installation-ID:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" x:Name="LicenseInstallationIdText" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Computername:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LicenseMachineNameText" TextTrimming="CharacterEllipsis" Margin="0,0,16,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Benutzername:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="LicenseUserNameText" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Terminalserver:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LicenseTerminalServerText" Margin="0,0,16,6"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Lizenzstatus:" FontWeight="Bold" Margin="0,0,8,6"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" x:Name="LicenseStatusText" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Aktive Geräte:" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LicenseActiveDeviceCountText" Margin="0,0,16,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Lizenzierte Geräte:" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="3" x:Name="LicenseLicensedDeviceCountText"/>
                            </Grid>
                        </GroupBox>

                        <Border Grid.Row="1"
                                BorderBrush="#E0A126"
                                BorderThickness="1"
                                Background="#FFF4D6"
                                CornerRadius="4"
                                Padding="10"
                                Margin="0,0,0,8">
                            <TextBlock Text="Achtung: Bei Hardwaretausch bitte neue Lizenz anfordern, Karenzzeit 7 Tage ab Umzug der Hardware."
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="#5A3A00"/>
                        </Border>

                        <GroupBox Header="Kundendaten für Lizenzanforderung" Grid.Row="2" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <GroupBox Header="Praxis/Firma und Adresse" Grid.Row="0" Margin="0,0,0,8">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Kundennummer:" FontWeight="Bold" Margin="0,0,8,6"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" x:Name="LicenseCustomerNumberTextBox" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Praxis-/Firmenname:" FontWeight="Bold" Margin="0,0,8,6"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="LicenseCustomerNameTextBox" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Straße / Hausnummer:" FontWeight="Bold" Margin="0,0,8,0"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="LicenseCustomerStreetTextBox" Margin="0,0,16,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="PLZ / Ort:" FontWeight="Bold" Margin="0,0,8,0"/>
                                        <Grid Grid.Row="2" Grid.Column="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="LicenseCustomerPostalCodeTextBox"/>
                                            <TextBox Grid.Column="2" x:Name="LicenseCustomerCityTextBox"/>
                                        </Grid>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Kontakt" Grid.Row="1" Margin="0,0,0,8">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Telefon:" FontWeight="Bold" Margin="0,0,8,6"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="LicenseCustomerPhoneTextBox" Margin="0,0,16,6"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="E-Mail:" FontWeight="Bold" Margin="0,0,8,6"/>
                                        <TextBox Grid.Row="0" Grid.Column="3" x:Name="LicenseCustomerEmailTextBox" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ansprechpartner:" FontWeight="Bold" Margin="0,0,8,0"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="LicenseCustomerContactPersonTextBox" Margin="0,0,16,0"/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Rechnungsversand" Grid.Row="2" Margin="0,0,0,8">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Rechnungs-E-Mail:" FontWeight="Bold" Margin="0,0,8,6"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="LicenseInvoiceEmailTextBox" Margin="0,0,0,6"/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Bankverbindung / SEPA" Grid.Row="3" Margin="0,0,0,8">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="IBAN:" FontWeight="Bold" Margin="0,0,8,6"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="LicenseCustomerIbanTextBox" Margin="0,0,16,6"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="BIC:" FontWeight="Bold" Margin="0,0,8,6"/>
                                        <TextBox Grid.Row="0" Grid.Column="3" x:Name="LicenseCustomerBicTextBox" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Kontoinhaber:" FontWeight="Bold" Margin="0,0,8,6"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="LicenseCustomerAccountHolderTextBox" Margin="0,0,0,6"/>
                                        <StackPanel Grid.Row="2"
                                                    Grid.Column="1"
                                                    Grid.ColumnSpan="3"
                                                    Orientation="Horizontal">
                                            <CheckBox x:Name="LicenseSepaConsentCheckBox"
                                                      Content="Einwilligung SEPA-Lastschrift"
                                                      Margin="0,0,24,0"
                                                      Checked="LicensePaymentOption_Checked"/>
                                            <CheckBox x:Name="LicenseAlwaysInvoiceCheckBox"
                                                      Content="Kein SEPA - bitte immer Rechnung zusenden"
                                                      Checked="LicensePaymentOption_Checked"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>

                                <Border Grid.Row="4"
                                        Style="{StaticResource XdtBoxInfoCardStyle}"
                                        Margin="0,0,0,8">
                                    <TextBlock x:Name="LicenseCustomerDataStatusText"
                                               Foreground="#2F6F4E"
                                               TextWrapping="Wrap"
                                               Text="Die Gerätenamen dienen nur der Dokumentation der Lizenzanfrage. Lizenzpflichtig ist ausschließlich die Anzahl aktivierter Geräteanbindungen."/>
                                </Border>

                                <Button Grid.Row="5"
                                        Content="Speichern"
                                        Width="140"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource XdtBoxSecondaryButtonStyle}"
                                        Click="SaveLicenseCustomerData_Click"/>
                            </Grid>
                        </GroupBox>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Lizenzanfrage exportieren" Width="190" Margin="0,0,8,0" Click="ExportLicenseRequest_Click"/>
                            <Button Content="Lizenz importieren" Width="190" Margin="0,0,8,0" Click="ImportLicenseFile_Click"/>
                            <Button Content="Lizenz entfernen" Width="170" Margin="0,0,8,0" Click="RemoveLicenseFile_Click"/>
                            <Button Content="Karenzzeiten aktualisieren" Width="210" Margin="0,0,8,0" Click="UpdateGracePeriods_Click"/>
                            <Button Content="Gerätestandorte speichern" Width="220" Click="SaveLicenseDeviceLocations_Click"/>
                        </StackPanel>

                        <GroupBox Header="Lizenzierte Geräte / Anbindungen" Grid.Row="4" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="340"/>
                                </Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="Lizenzpflichtige Anbindungen gesamt:" FontWeight="Bold" Margin="0,0,8,6"/>
                                    <TextBlock x:Name="LicensedDeviceTotalCountText" MinWidth="36" Margin="0,0,18,6"/>
                                    <TextBlock Text="Aktive lizenzpflichtige Anbindungen:" FontWeight="Bold" Margin="0,0,8,6"/>
                                    <TextBlock x:Name="LicensedDeviceActiveCountText" MinWidth="36" Margin="0,0,18,6"/>
                                    <TextBlock Text="Lizenzierte Geräteanzahl:" FontWeight="Bold" Margin="0,0,8,6"/>
                                    <TextBlock x:Name="LicensedDeviceLicensedCountText" MinWidth="36" Margin="0,0,18,6"/>
                                    <TextBlock Text="Gedeckt:" FontWeight="Bold" Margin="0,0,8,6"/>
                                    <TextBlock x:Name="LicensedDeviceCoveredCountText" MinWidth="36" Margin="0,0,18,6"/>
                                    <TextBlock Text="Nicht gedeckt:" FontWeight="Bold" Margin="0,0,8,6"/>
                                    <TextBlock x:Name="LicensedDeviceUncoveredCountText" MinWidth="36" Margin="0,0,18,6"/>
                                    <TextBlock Text="In Karenzzeit:" FontWeight="Bold" Margin="0,0,8,6"/>
                                    <TextBlock x:Name="LicensedDeviceGraceCountText" MinWidth="36" Margin="0,0,0,6"/>
                                </WrapPanel>

                                <TextBlock Grid.Row="1"
                                           x:Name="LicensedDeviceStatusText"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>

                                <DataGrid Grid.Row="2"
                                          x:Name="LicensedDeviceStatesGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          MinHeight="250">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" MinWidth="320" Width="*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Standort" Binding="{Binding Standort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="170" Width="170"/>
                                        <DataGridTextColumn Header="Aktiv" Binding="{Binding AktivText}" MinWidth="70" Width="70" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Lizenzpflichtig" Binding="{Binding LizenzpflichtigText}" MinWidth="110" Width="110" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Gedeckt" Binding="{Binding GedecktText}" MinWidth="90" Width="90" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Karenz" Binding="{Binding KarenzText}" MinWidth="90" Width="90" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Karenz bis" Binding="{Binding KarenzBisText}" MinWidth="140" Width="140" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Rest-Karenzzeit" Binding="{Binding KarenzVerbleibendText}" MinWidth="140" Width="140" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" MinWidth="420" Width="2*" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Lizenzmeldungen" Grid.Row="5">
                            <TextBox x:Name="LicenseMessagesTextBox"
                                     Margin="8"
                                     MinHeight="280"
