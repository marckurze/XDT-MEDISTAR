                                <Expander x:Name="InterfaceSerialCommunicationGroupBox" Header="Serielle Gerätekommunikation / COM-Port" IsExpanded="True" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
