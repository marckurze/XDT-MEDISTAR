@page
@model XdtBox.LicenseWeb.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Einstellungen";
}

<h1 class="h3 mb-3">Einstellungen</h1>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info">@Model.StatusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="row g-3">
    <div class="col-lg-6">
        <div class="xdt-card">
            <h2 class="h5">Abrechnung</h2>
            <form method="post">
                <div class="mb-3">
                    <label asp-for="PricePerDeviceNet" class="form-label">Einzelpreis netto pro Geräteanbindung</label>
                    <input asp-for="PricePerDeviceNet" class="form-control" />
                </div>
                <button class="btn btn-primary" type="submit">Speichern</button>
            </form>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="xdt-card">
            <h2 class="h5">Serverstatus</h2>
            <dl class="row mb-0">
                <dt class="col-sm-4">Datenroot</dt><dd class="col-sm-8"><code>@Model.DataRoot</code></dd>
                <dt class="col-sm-4">Private Key</dt><dd class="col-sm-8">@Model.PrivateKeyStatus</dd>
                <dt class="col-sm-4">Issuer</dt><dd class="col-sm-8">@Model.Issuer</dd>
            </dl>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="xdt-card">
            <h2 class="h5">Admin-Passwort</h2>
            <form method="post" asp-page-handler="ChangePassword">
                <div class="mb-3">
                    <label asp-for="CurrentAdminPassword" class="form-label">Aktuelles Passwort</label>
                    <input asp-for="CurrentAdminPassword" class="form-control" type="password" autocomplete="current-password" />
                </div>
                <div class="mb-3">
                    <label asp-for="NewAdminPassword" class="form-label">Neues Passwort</label>
                    <input asp-for="NewAdminPassword" class="form-control" type="password" autocomplete="new-password" />
                </div>
                <div class="mb-3">
                    <label asp-for="RepeatAdminPassword" class="form-label">Neues Passwort wiederholen</label>
                    <input asp-for="RepeatAdminPassword" class="form-control" type="password" autocomplete="new-password" />
                </div>
                <button class="btn btn-primary" type="submit">Passwort ändern</button>
            </form>
        </div>
    </div>
</div>

<div class="xdt-card mt-3">
    <h2 class="h5">Produktivdiagnose</h2>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>Pruefung</th>
                    <th>Status</th>
                    <th>Hinweis</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Diagnostics)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>
                        <span class="badge @(item.IsOk ? "text-bg-success" : "text-bg-warning")">@item.Status</span>
                    </td>
                    <td>@item.Detail</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
