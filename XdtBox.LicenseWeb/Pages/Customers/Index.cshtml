@page
@model XdtBox.LicenseWeb.Pages.Customers.IndexModel
@{
    ViewData["Title"] = "Kunden";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Kunden</h1>
    <div class="d-flex gap-2">
        <form id="mergeForm" method="post" asp-page-handler="MergeSelected" onsubmit="return confirm('Markierte Kunden zusammenführen? Der erste markierte Kunde bleibt der Zielkunde.');">
            <button class="btn btn-outline-primary" type="submit">Markierte Kunden zusammenführen</button>
        </form>
        <a class="btn btn-outline-primary" asp-page-handler="TotalPdf">Gesamt-PDF</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info">@Model.StatusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (!Model.Customers.Any())
{
    <div class="alert alert-info">Noch keine Kunden im konfigurierten Datenroot vorhanden.</div>
}
else
{
    <div class="table-responsive xdt-card">
        <table class="table table-hover align-middle">
            <thead>
            <tr>
                <th class="xdt-select-column"></th>
                <th>Kundennummer</th>
                <th>Kunde / Praxis / Firma</th>
                <th>Ort</th>
                <th>Rechnungs-E-Mail</th>
                <th>Zahlungsart</th>
                <th class="text-end">Installationen</th>
                <th class="text-end">Geräte aktiv</th>
                <th class="text-end">Monatssumme netto</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var customer in Model.Customers)
            {
                <tr class="customer-row" data-href="@Url.Page("/Customers/Details", new { id = customer.Id })" tabindex="0" aria-label="Kunde @customer.CustomerName öffnen">
                    <td>
                        <input class="form-check-input customer-select" type="checkbox" name="SelectedCustomerIds" value="@customer.Id" form="mergeForm" aria-label="Kunde @customer.CustomerName markieren" />
                    </td>
                    <td>@customer.CustomerNumber</td>
                    <td>@customer.CustomerName</td>
                    <td>@customer.City</td>
                    <td>@customer.InvoiceEmail</td>
                    <td>@customer.PaymentMethod</td>
                    <td class="text-end">@customer.ActiveInstallationCount</td>
                    <td class="text-end">@customer.ActiveDeviceCount</td>
                    <td class="text-end">@customer.MonthlyTotal</td>
                    <td class="text-nowrap text-end customer-actions">
                        <a class="btn btn-sm btn-outline-secondary" asp-page-handler="CustomerPdf" asp-route-id="@customer.Id" download>Kunden-PDF</a>
                        <form class="d-inline" method="post" asp-page-handler="Delete" asp-route-id="@customer.Id" onsubmit="return confirm('Diesen Kunden wirklich löschen?');">
                            <button class="btn btn-sm btn-outline-danger" type="submit" title="Kunden löschen" aria-label="Kunden löschen">&#128465;</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
