@page
@model XdtBox.LicenseWeb.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Anmelden";
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="xdt-card mt-4">
            <h1 class="h4 mb-3">XDTBox Lizenzmanager Web</h1>
            @if (!Model.IsConfigured)
            {
                <div class="alert alert-warning">
                    Kein Admin-Zugang konfiguriert. Bitte `LicenseWeb:Admin:Username`, `PasswordHash` und `PasswordSalt` serverseitig konfigurieren.
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
            <form method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="mb-3">
                    <label asp-for="UserName" class="form-label">Benutzer</label>
                    <input asp-for="UserName" class="form-control" autocomplete="username" />
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Passwort</label>
                    <input asp-for="Password" class="form-control" type="password" autocomplete="current-password" />
                </div>
                <button class="btn btn-primary" type="submit" disabled="@(!Model.IsConfigured)">Anmelden</button>
            </form>
        </div>
    </div>
</div>
